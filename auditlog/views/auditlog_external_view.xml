<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <menuitem
        id="menu_auditlog_external"
        name="Audit Log"
        web_icon="auditlog,static/description/icon.png"
        groups="auditlog.group_auditlog_user"
        sequence="20"
    />



    <record id="action_auditlog_line_menu_action" model="ir.actions.act_window">
        <field name="name">Log Lines Action</field>
        <field name="res_model">auditlog.log.line.view</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_auditlog_line_search" />
        <field name="context">{'search_default_group_by_model_id': 1}</field>
    </record>


    <menuitem
        id="menu_auditlog_line_external"
        name="Audit Line"
        action="action_auditlog_line_menu_action"
        parent="menu_auditlog_external"
        sequence="20"
    />


    <record id="action_auditlog_log_menu_action" model="ir.actions.act_window">
        <field name="name">Log</field>
        <field name="res_model">auditlog.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_auditlog_log_search" />
        <field name="context">{'search_default_group_by_model_id': 1}</field>
    </record>   


    <menuitem
        id="menu_auditlog_log_external"
        name="Audit Log"
        action="action_auditlog_log_menu_action"
        parent="menu_auditlog_external"
        sequence="10"
    />



</odoo>