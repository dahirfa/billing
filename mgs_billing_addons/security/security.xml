<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_mgs_utility_balance_transfer" model="res.groups">
        <field name="name">Utility Balance Transfer</field>
    </record>

    <record id="group_billing_meter_reader" model="res.groups">
        <field name="category_id" ref="mgs_billing.module_mgs_billing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4, ref('account.group_account_invoice'))]"/>
        <field name="name">Meter Reader</field>
    </record>

    <record id="mgs_billing.group_billing_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_billing_meter_reader'))]"/>
    </record>

    <record id="mgs_billing.mgs_billing_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('mgs_billing_addons.group_billing_meter_reader'))]"/>
        <!-- <field name="inherit_id" ref="mgs_billing.mgs_billing_root"/> -->
        <!-- You can add other fields as needed -->
    </record>

