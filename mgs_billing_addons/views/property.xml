<odoo>
  <record id="mgs_billing_form_inehrit" model="ir.ui.view">
    <field name="name">mgs_billing.property.form.inehrit</field>
    <field name="model">mgs_billing.property</field>
    <field name="inherit_id" ref="mgs_billing.mgs_billing_property_form" />
    <field name="arch" type="xml">

      <xpath expr="//sheet" position="inside">
        <group string="Misc.">
          <group>
            <field name="pipe_extention" string='Nooca Tuubada Biyaha Laga Qabanaayo' />
            <field name="pipe_type" string="Nooca Tuubada La Jiidaayo" />
            <field name="meter_category" string="Nooca Saacada" />
            <field name="old_house_no" />
          </group>

          <group>
            <field name="technician"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

  <record id="mgs_reading_search_inherit" model="ir.ui.view">
    <field name="name">mgs.reading.search.inherit</field>
    <field name="model">mgs_billing.reading</field>
    <field name="inherit_id" ref="mgs_billing.mgs_billing_reading_search" />
    <field name="arch" type="xml">
      <!-- Modify or extend the search view as needed -->
      <xpath expr="//filter[@name='property_id']" position="after">
       
      </xpath>
    </field>
  </record>

  <record model="ir.ui.menu" id="mgs_billing.mgs_billing_transaction_partner">
    <field name="active">0</field>
  </record>

  <record model="ir.ui.menu" id="mgs_billing.mgs_billing_property_menu">
    <field name="active">0</field>
  </record>

  <menuitem id="mgs_billing_Property_main" name="Properties" parent="mgs_billing.mgs_billing_root" sequence="5" />

  <menuitem id="mgs_billing_owner2_menu" name="Billing Customers" parent="mgs_billing_Property_main" action="mgs_billing.mgs_billing_owner_action" sequence="1" />
</odoo>
