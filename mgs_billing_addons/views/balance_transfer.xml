<odoo>
    <data>
        <record model="ir.sequence" id="balance_transfer">
            <field name="name">Balance Transfer</field>
            <field name="code">mgs_billing_addons.balance_transfer</field>
            <field name="prefix">BT/%(year)s%(month)s/</field>
            <field name="padding">3</field>
        </record>
        <!-- Bulk Payment Tree View -->
        <record id="view_balance_transfer_tree" model="ir.ui.view">
            <field name="name">bulk.payment.tree</field>
            <field name="model">mgs_billing_addons.balance_transfer</field>
            <field name="arch" type="xml">
                <list decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='confirm'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="billing_account_id"/>
                    <field name="total"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Bulk Payment Form View -->
        <record id="view_balance_transfer_form" model="ir.ui.view">
            <field name="name">bulk.payment.form</field>
            <field name="model">mgs_billing_addons.balance_transfer</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                       
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
                       
                        <button string="Cancel" name="action_cancel" type="object" invisible="state not in ['confirm']"/>

                        <button string="Reset To Draft" name="action_draft" invisible="state not in ['cancel']" type="object"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_journal_entry" invisible="not move_id" type="object" width="150" class="oe_stat_button" icon="fa-credit-card"> Journal Entry
                            </button>
                        </div>

                        <h1><field name="name" readonly="1"/></h1>
                        <group>
                            <group>
                                <field name="billing_account_id" string="Transfer From" options="{'no_create': True}" readonly="state != 'draft'"/>
                                <field name="cust_balance"/>
                                <field name="move_id" invisible="1"/>
                            </group>

                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Transfer To">
                                <field name="transfer_lines" context="{'default_transfer_id': id}" mode="list,kanban" nolabel="1" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="partner_id" options="{'no_create': True}"/>
                                        <field name="amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <field name="total" widget="monetary" options="{'currency_field': 'journal_id'}"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_balance_transfer_search" model="ir.ui.view">
            <field name="name">bulk.payment.search</field>
            <field name="model">mgs_billing_addons.balance_transfer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- Bulk Payment Action Window -->
        <record id="action_balance_transfer" model="ir.actions.act_window">
            <field name="name">Balance Transfers</field>
            <field name="res_model">mgs_billing_addons.balance_transfer</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
    <menuitem id="mgs_billing_transaction_utility" name="Utility" parent="mgs_billing.mgs_billing_root" sequence="60"/>
    <menuitem id="menu_balance_transfer" name="Balance Transfers" parent="mgs_billing_transaction_utility" sequence="1" action="action_balance_transfer" groups="group_mgs_utility_balance_transfer"/>
</odoo>