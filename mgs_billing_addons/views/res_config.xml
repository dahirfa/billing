<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="helpdesk_setting_inherit_mgs" model="ir.ui.view">
        <field name="name">Helpdesk Setting Inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="500"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/app[@name='helpdesk']" position="inside">
                    <div class="row mt16 o_settings_container" name="helpdesk_defaults_mgs">
                        <div class="col-12 col-lg-6 o_setting_box" id="helpdesk_defaults_mgs">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Defaults</span>
                                <span class="fa fa-lg fa-building-o" groups="base.group_no_one" role="img"/>                                
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="team_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="team_id"/>
                                    </div>                                    
                                </div>
                            </div>
                        </div>
                    </div>       
            </xpath>
        </field>
    </record>
</odoo>
