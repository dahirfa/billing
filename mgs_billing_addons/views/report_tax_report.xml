<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <report
        id="action_mgs_tax_report"
        name="mgs_billing_addons.tax_report_report"
        model="mgs_billing_addons.tax_report_report"
        string="Tax Report"
        report_type="qweb-html"
        />

        <template id="tax_report_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout" t-lang="en_US">
                        <div class="page">
                            <style>
                                th, td {
                                    padding: 0.30rem !important;
                                    border-top: 1px solid #212529 !important;
                                    border-bottom: 1px solid #212529 !important;
                                }
                            </style>

                            <div class="container" style="font-size:12px;font-family:Arial;margin-top:1px;">
                                <h2>Payment and Receipt</h2>

                                <div class="row" style="margin-top: 32px !important;font-size: 1.2em; font-family: 'Lato-Reg'">
                                    <div class="col-3" t-if="date_from or date_to">
                                        <strong>Date:</strong>
                                        <p t-esc="date_from" style="margin-bottom: 0"/>
                                        <p t-esc="date_to"/>
                                    </div>

                                    <div class="col-3" t-if="account_id[0]">
                                        <strong>Account:</strong>
                                        <p class="m-0" t-esc="account_id[1]"/>
                                    </div>

                                    <div class="col-3" t-if="report_type">
                                        <strong>Report Type:</strong>
                                        <p class="m-0" t-esc="report_type"/>
                                    </div>

                                    <div class="col-4" t-if="company_id" groups="base.group_multi_company">
                                        <strong>Company:</strong>
                                        <span style="border: 1px solid black; padding: 1px; border-radius: 4px; background: #eeebeb; margin-right: 2px " t-esc="company_id.name"/>
                                    </div>
                                </div>

                                <table class="table table-condensed table-sm">
                                    <thead>
                                        <tr>
                                            <th style="text-align: center" nowrap="nowrap">No</th>
                                            <th nowrap="nowrap">Date</th>
                                            <th>Ref</th>
                                            <th>Partner</th>
                                            <th style="text-align: right">Tax Amount</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <t t-set="no" t-value="0"/>
                                        <t t-set="total_amount" t-value="0"/>
                                        <!-- <span t-esc="lines(date_from, date_to, company_id.id, account_id[0], report_type)"" -->
                                        <tr t-foreach="lines(date_from, date_to, company_id.id, account_id[0], report_type)" t-as="line">
                                            <t t-set="no" t-value="no+1"/>
                                            <t t-set="total_amount" t-value="total_amount+line.credit"/>

                                            <td style="text-align: center" nowrap="nowrap"><span t-esc="no"/></td>
                                            <td nowrap="nowrap"><span t-esc="line.date"/></td>
                                            <td><span t-esc="line.move_id.name"/></td>
                                            <td><span t-esc="line.partner_id.name"/></td>
                                            <td style="text-align: right"><span t-esc="'{0:,.2f}'.format(line.credit)"/></td>
                                        </tr>

                                        <tr style="font-weight: bold;font-size: 13px">
                                            <td colspan="4"></td>
                                            <td style="text-align: right"><span style="color: red; font-weight: bold;" t-esc="'{0:,.2f}'.format(total_amount)"/></td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div> <!--container-->
                        </div> <!--page-->
                    </t> <!--web.external_layout-->
                </t>
            </t> <!--web.html_container-->
        </template>
</odoo>
