<odoo>
    <data>
        <record id="mgs_inherit_view_account_payment_form" model="ir.ui.view">
            <field name="name">account.view_account_payment_form.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="zone_id" readonly="1"/>]
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="bulk_payment_id" invisible="1"/>
                    <field name="mgs_p_transaction_id" invisible="1"/>
                    <field name="mgs_sahal_im_line_id" invisible="1"/>
                    <button name="action_open_mgs_payment" type="object" class="oe_stat_button" icon="fa-money" invisible="not bulk_payment_id and not mgs_p_transaction_id and not mgs_sahal_im_line_id">
                        Source
                    </button>
                </xpath>
            </field>
        </record>

        <record id="mgs_inherit_view_account_payment_tree" model="ir.ui.view">
            <field name="name">view_account_payment_tree.tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="zone_id"/>
                </xpath>
            </field>
        </record>




        <record model="ir.sequence" id="bulk_payments">
            <field name="name">Bulk Payments</field>
            <field name="code">mgs_billing_addons.bulk_payment</field>
            <field name="prefix">BP/%(year)s%(month)s/</field>
            <field name="padding">3</field>
        </record>
        <!-- Bulk Payment Tree View -->
        <record id="view_bulk_payment_tree" model="ir.ui.view">
            <field name="name">bulk.payment.tree</field>
            <field name="model">mgs_billing_addons.bulk_payment</field>
            <field name="arch" type="xml">
                <list decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='confirm'">
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="date"/>
                    <field name="total"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Bulk Payment Form View -->
        <record id="view_bulk_payment_form" model="ir.ui.view">
            <field name="name">bulk.payment.form</field>
            <field name="model">mgs_billing_addons.bulk_payment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!--TODO: Result from converting "states='draft'" attribute into an 'invisible' attribute
                             Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
                        <!--TODO: Result from converting "states='confirm'" attribute into an 'invisible' attribute
                             Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                        <button string="Cancel" name="action_cancel" type="object" invisible="state not in ['confirm']"/>
                        <!--TODO: Result from converting "states='cancel'" attribute into an 'invisible' attribute
                             Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                        <button string="Reset To Draft" name="action_draft" invisible="state not in ['cancel']" type="object"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_payments" invisible="payment_count == 0" type="object" width="150" class="oe_stat_button" icon="fa-credit-card">  <field name="payment_count" widget="statinfo" string="Payments"/>
                            </button>
                        </div>

                        <h1><field name="name" readonly="1"/></h1>
                        <group>
                            <group>
                                <field name="journal_id" readonly="state != 'draft'"/>
                                <field name="amount" readonly="state != 'draft'"/>
                            </group>

                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="mgs_sender_phone"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payment Lines">
                                <field name="payment_lines" mode="list,kanban" nolabel="1" readonly="state != 'draft'">
                                    <list editable="top">
                                        <field name="partner_id"/>
                                        <field name="amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <field name="total" widget="monetary" options="{'currency_field': 'journal_id'}"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </sheet>
                    <!-- <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"/>
                    </footer> -->
                </form>
            </field>
        </record>

        <record id="view_bulk_payment_search" model="ir.ui.view">
            <field name="name">bulk.payment.search</field>
            <field name="model">mgs_billing_addons.bulk_payment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- Bulk Payment Action Window -->
        <record id="action_bulk_payment" model="ir.actions.act_window">
            <field name="name">Bulk Payments</field>
            <field name="res_model">mgs_billing_addons.bulk_payment</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
    <menuitem id="menu_bulk_payment" name="Bulk Payments" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="1" action="action_bulk_payment"/>
</odoo>