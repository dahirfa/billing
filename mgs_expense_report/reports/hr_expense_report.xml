<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_hr_expense_report" model="ir.actions.report">
        <field name="name">Expense Report</field>
        <field name="model">hr.expense.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_expense_report.hr_expense_report_template</field>
        <field name="report_file">mgs_expense_report.hr_expense_report_template</field>
        <field name="binding_type">report</field>
    </record>

    <template id="hr_expense_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                
                <div class="page">
                    <style>
                        th, td {
                            padding: 0.30rem !important;
                            border-top: 1px solid #212529 !important;
                            border-bottom: 1px solid #212529 !important;
                        }
                        th{

                            font-weight:bold;
                        }
                        </style>

                    <div class="container" style="font-size:14px;font-family:Arial;margin-top:1px;">
                    <h2 style="text-align:center;">Expense Report</h2>
                    <p style="text-align:center;">
                        From <t t-esc="date_from"/> To <t t-esc="date_to"/>
                    </p>

                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Employee</th>
                                <th>Journal</th>
                                <th>Paid By</th>
                                <th>State</th>
                                <th>Payment State</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="get_report_lines(data)" t-as="line">
                                <td nowrap="nowrap"><t t-esc="line['date']"/></td>
                                <td><t t-esc="line['description']"/></td>
                                <td><t t-esc="line['product']"/></td>
                                <td><t t-esc="line['employee']"/></td>
                                <td><t t-esc="line['journal']"/></td>
                                <td><t t-esc="line['payment_mode']"/></td>
                                <td><t t-esc="line['state']"/></td>
                                <td><t t-esc="line['payment_state']"/></td>
                                <td style="text-align:right;">
                                    <t t-esc="line['amount']" t-options='{"widget": "monetary", "display_currency": env.user.company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot style="font-weight:bold; background:#ffe6e6;">
                            <tr>
                                <td colspan="8" class="text-right"><strong>Total</strong></td>
                                <td style="text-align:right;">
                                    <strong>
                                        <t t-esc="sum(line['amount'] for line in get_report_lines(data))" 
                                           t-options='{"widget": "monetary", "display_currency": env.user.company_id.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    
                </div>
                </div>
            </t>
        </t>
    </template>
</odoo>