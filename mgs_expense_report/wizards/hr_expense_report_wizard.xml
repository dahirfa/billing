<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.report.wizard.form</field>
        <field name="model">hr.expense.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Expense Report Wizard">
                <group>
                    <field name="product_id"/>
                    <field name="journal_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button string="Print" type="object" name="action_print_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_report_wizard" model="ir.actions.act_window">
        <field name="name">Expense Report</field>
        <field name="res_model">hr.expense.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="hr_expense_report_wizard_menu"
        name="Expense Report"
        action="action_hr_expense_report_wizard"
        parent="hr_expense.menu_hr_expense_reports"
        sequence="10"/>
</odoo>
