<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="tax_report_form" model="ir.ui.view">
			<field name="name">mgs_necsom_addons.tax_report.form</field>
			<field name="model">mgs_necsom_addons.tax_report</field>
			<field name="arch" type="xml">
			   <form>
					<sheet>
						<group>
							<group>
								<field name="date_from" string = "From"/>
								<field name="account_id" string="Account" options="{'no_create': True}" />
								<field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
							</group>


							<group>
								<field name="date_to" string="To"/>
								<field name="report_type" widget="radio"/>
							</group>
						</group>
					</sheet>

				<footer>
					<button name="confirm" string="View" type="object" class="oe_highlight"/>
					<!-- <button name="export_to_excel" string="EXCEL" type="object" class="oe_highlight"/> -->
					<button string="Cancel" special="cancel"/>
				</footer>

			   </form>
			</field>
		</record>



		<record id="action_tax_report_report" model="ir.actions.act_window">
			<field name="name">Tax Report</field>
			<field name="res_model">mgs_necsom_addons.tax_report</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_id" ref="tax_report_form"/>
			<field name="target">new</field>
		</record>

    <!-- <menuitem id="menu_necsom_addons_report" name="Reporting" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="12" /> -->
    <menuitem id="menu_necsom_addons_tax_report" name="Tax Report" parent="account.menu_finance_reports" action="action_tax_report_report" sequence="7" />
</odoo>
