<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View mgs.asset.location View Tree -->
    <record id="view_mgs_asset_location_tree" model="ir.ui.view">
        <field name="name">view.mgs.asset.location.tree</field>
        <field name="model">mgs.asset.location</field>
        <field name="arch" type="xml">
            <list editable="top" default_order="id desc" sample='1' decoration-bf="1">
                <field name="name"/>
                <field name="location_responsible"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- View mgs.asset.location search -->
    <record id="view_mgs_asset_location_search" model="ir.ui.view">
        <field name="name">view.mgs.asset.location.search</field>
        <field name="model">mgs.asset.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location_responsible"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <!-- Action mgs.asset.location -->
    <record id="action_mgs_asset_location" model="ir.actions.act_window">
        <field name="name">Asset Location</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mgs.asset.location</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no Asset Location click new to add new Asset Location.
            </p>
        </field>
    </record>



    <menuitem
        id="mgs_asset_location_menu"
        name="Asset Location"
        action="action_mgs_asset_location"
        groups="base.group_erp_manager"
        parent="account.account_management_menu"
        sequence="10"/>


    <!-- ACCOUNT ASSET INHERIT -->


    <record id="account_asset_inherit" model="ir.ui.view">
        <field name="name">account.asset.view.form.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="mgs_location_id"/>
            </xpath>
            
        </field>
    </record>

</odoo>
