        <xpath expr="//t[@t-call='portal.portal_table']/td[@class='page_total']" position="after">
            <td></td>
        </xpath>
    </template> -->

    <record id="search_paymentold" model="ir.ui.view">
            <field name="name">mgs_necsom_addons.seach_sender.wizard.form</field>
            <field name="model">mgs_necsom_addons.seach_sender</field>
            <field name="arch" type="xml">
                <form string="Collect">
                    <group>
                      <group>
                        <field name="mgs_sender_phone" required="1"/>
                      </group>
                      <group>
                        <!-- <button string="Search" name="search_records" type="object" default_focus="1" class="btn-primary"/> -->
                      </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="sender_no_ids" readonly="1" invisible="not mgs_sender_phone">
                                <list> 
                                    <field name="name"/>
                                    <field name="customer_name"/>
                                    <field name="payment_on"/>
                                    <field name="sender_phone"/>
                                    <field name="amount_paid"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                
                    <footer>
                        <button string="Close" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_search_by_sender_no" model="ir.actions.act_window">
			<field name="name">Search by Sender Number</field>
			<field name="res_model">mgs_necsom_addons.seach_sender</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_id" ref="search_paymentold"/>
			<field name="target">new</field>
		</record>

    <menuitem id="menu_necsom_addons_search_paymentold" name="Search by Sender #" parent="mgs_necsom_addons.menu_necsom_addons_report" action="action_search_by_sender_no" sequence="3"/>
    <menuitem id="menu_necsom_addons_search_paymentold2" name="Search by Sender #" parent="mgs_billing_transaction_utility" action="action_search_by_sender_no" sequence="3"/>

</odoo>