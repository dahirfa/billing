        <xpath expr="//t[@t-call='portal.portal_table']/thead/tr/th[@class='partner_mobile']" position="after">
            <th>Sender Mobile</th>
        </xpath>

        <xpath expr="//t[@t-call='portal.portal_table']/td[@class='partner_mobile']" position="after">
            <td><span t-esc="line['sender_phone']"/></td>
