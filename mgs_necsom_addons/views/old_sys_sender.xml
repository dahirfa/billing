<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="old_sys_sender_tree" model="ir.ui.view">
        <field name="name">mgs_necsom_addons.old_sys_sender.tree</field>
        <field name="model">mgs_necsom_addons.old_sys_sender</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
                <field name="customer_name"/>
                <!-- <field name="billing_account_id" options="{'no_create': True}"/> -->
                <field name="mgs_created_on"/>
                <field name="payment_mode"/>
                <field name="payment_on"/>
                <field name="sender_phone"/>
                <field name="amount_paid"/>
                <field name="receiver_account"/>
                <field name="cashier"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="old_sys_sender_action" model="ir.actions.act_window">
        <field name="name">Old System Senders</field>
        <field name="res_model">mgs_necsom_addons.old_sys_sender</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="old_sys_sender_menu" name="Old Sys Senders" action="old_sys_sender_action" parent="mgs_billing.mgs_billing_transaction_config" sequence="12" groups="base.group_erp_manager"/>


      <record id="view_mgs_billing_receivables_inherit" model="ir.ui.view">
        <field name="name">mgs.billing.receivables.wizard.line.inherit</field>
        <field name="model">mgs_billing.receivables.wizard.line</field>
        <field name="inherit_id" ref="mgs_billing.view_mgs_billing_receivables_wizard_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='billing_account_id']" position="after">
                <field name="sender_phone"/>
            </xpath>
        </field>
    </record>

    <template id="portal_my_receivables" name="Portal on My Receivales" inherit_id="mgs_billing.bill_receivables_report_template">
        <xpath expr="//t[@t-call='portal.portal_table']/thead/tr/th[@class='partner_mobile']" position="after">
            <th>Sender Mobile</th>
        </xpath>

        <xpath expr="//tr[@t-foreach='data']/td[hasclass('partner_mobile')]" position="after">
            <td>
                <span t-esc="line['sender_phone']"/>
                <!-- <t t-if="line['mgs_sender_phone']">
                    / <span t-esc="line['mgs_sender_phone']"/>
                </t> -->
            </td>
        </xpath>
        <xpath expr="//t[@t-call='portal.portal_table']/tbody/tr/td[@class='page_subtotal']" position="after">
            <td/>
        </xpath>

        <xpath expr="//t[@t-call='portal.portal_table']/tbody/tr/td[@class='page_total']" position="after">
            <td/>
        </xpath>
    </template>

