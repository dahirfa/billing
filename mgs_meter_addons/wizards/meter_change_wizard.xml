<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mgs_meter_create_customer_wizard_form" model="ir.ui.view">
        <field name="name">mgs_meter.create_customer.wizard.form</field>
        <field name="model">mgs_meter.create.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                  <field name="meter_id" placeholder="Serial #"/>
                    <p style='color:green;' invisible="meterid == 'Invalid' or meter_id == False">Valid Serial Number</p>
                    <p style='color:red;' invisible="meterid != 'Invalid' or meter_id == False">This Serial number is Invalid or Used</p>
                    
                    <field name="property_id" invisible='1' readonly="1" string="Property#" options="{'no_create': True}" />
                    <field name="meterid" invisible='1'/>
                </sheet>

                <footer>
                  <button name="action_confirm" invisible="meterid == 'Invalid' or meter_id == False" string="Confirm" type="object" class="oe_highlight"/>
                  <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mgs_meter_create_customer_action" model="ir.actions.act_window">
        <field name="name">Assign Meter</field>
        <field name="res_model">mgs_meter.create.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
