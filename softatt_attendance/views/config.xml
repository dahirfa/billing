<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr_attendance.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Locate the Extra Hours block and insert after it -->
            <xpath expr="//app[@name='hr_attendance']/block[@name='overtime_settings']" position="after">
                
                <block title="Softatt Settings" name="softatt_settings">
                    <!-- Attendance API Auth Section -->
                    <setting string="Attendance API Auth" company_dependent="1" help="Configure API connection for attendance.">
                        <div class="row mt16">
                            <div class="col-lg-8">
                                <label for="att_server_url">Server URL</label>
                                <field name="att_server_url" class="w-100"/>
                            </div>
                        </div>
                        <div class="row mt16">
                            <div class="col-lg-8">
                                <label for="att_db">Database</label>
                                <field name="att_db" class="w-100"/>
                            </div>
                        </div>

                        <div class="row mt16">
                            <div class="col-lg-8">
                                <label for="att_username">Username</label>
                                <field name="att_username" class="w-100"/>
                            </div>
                            
                        </div>
                        <div class="row mt16">
                            <div class="col-lg-8">
                                <label for="att_password">Password</label>
                                <field name="att_password" password="1" class="w-100"/>
                            </div>
                        </div>

                        <div class="row mt16">
                            <div class="col-lg-8">
                                <label for="att_limit">Limit</label>
                                <field name="att_limit" class="w-100"/>
                            </div>
                        </div>
                    </setting>

                    <!-- Employee Lateness Deductions -->
                    <setting string="Employee Lateness Deductions" company_dependent="1" help="Enable lateness deductions for employees.">
                        <div class="row mt16">
                            <div class="col-lg-6">
                                <label for="module_softatt_lateness_deductions">Enable Lateness Deductions</label>
                                <field name="module_softatt_lateness_deductions"/>
                            </div>
                        </div>
                    </setting>
                </block>

            </xpath>
        </field>
    </record>
</odoo>
