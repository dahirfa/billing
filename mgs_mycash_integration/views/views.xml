<odoo>
  <data>
    <record id="mgs_mycash_payment_inherit_payment_provider" model="ir.ui.view">
      <field name="name">MyCash Payment Integration Form</field>
      <field name="model">payment.provider</field>
      <field name="inherit_id" ref="payment.payment_provider_form"/>
      <field name="arch" type="xml">
        <group name="provider_credentials" position="inside">
          <group invisible="code != 'mycash'">
            <field name="mycash_user_id" password='1' required="code == 'mycash'" />
          </group>
        </group>
      </field>
    </record>

    <record id="mgs_mycash_inherit_payment_transaction" model="ir.ui.view">
      <field name="name">MyCash</field>
      <field name="model">mgs.payment.transaction</field>
      <field name="inherit_id" ref="mgs_payment_integration.mgs_payment_transaction_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='state']" position="after">
          <field name="method_code" invisible='1'/>
          <button name="action_mycash_confirm" invisible="method_code != 'mycash' or state == 'confirm'" type="object" string="Confirm"/>
          <button name="action_mycash_draft" invisible="method_code != 'mycash' or state == 'draft'" type="object" string="Reset To draft"/>
        </xpath>

      </field>
    </record>

    <record model="ir.actions.act_window" id="action_mgs_payment_transaction_mycash">
      <field name="name">MyCash Transactions</field>
      <field name="res_model">mgs.payment.transaction</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('method_code','=','mycash')]</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No Records</p>
      </field>
    </record>

    <menuitem name="MyCash" id="mgs_payment_integration_payment_menu_mycash" action="action_mgs_payment_transaction_mycash" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="4"/>


  </data>
</odoo>