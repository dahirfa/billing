<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_partnerledger">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        th, td {
                            padding: 0.30rem !important;
                            border-top: 1px solid #212529 !important;
                            border-bottom: 1px solid #212529 !important;
                        }
                        th{

                            font-weight:bold;
                        }
                        </style>
                    <t t-if="not extra['summary']">
                        <t t-foreach="docs" t-as="o">
                            <div style="page-break-after: always;">
                                <div style="font:25px lucida-console,sans-serif !important;font-weight: bold;">
                                    <strong>
                                        <div>
                                            <center> Customer Statement </center>
                                        </div>
                                    </strong>
                                </div>
                                <div class="row mt32 mb32">
                                    <div class="col-6">
                                        <strong>Partner's Account :</strong>
                                        <t t-if="extra['account_type'] == 'customer'">Receivable
                                            Accounts</t>
                                        <t t-if="extra['account_type'] == 'supplier'">Payable
                                            Accounts</t>
                                        <t t-if="extra['account_type'] == 'customer_supplier'">Receivable
                                            and Payable Accounts</t>
                                        <br />
                                        <t t-if="extra['date_from']">
                                            <strong>Start Date :</strong>
                                            <span t-esc="extra['date_from']" />
                                        </t>
                                    </div>
                                    <div class="col-6">
                                        <strong>Target Moves :</strong>
                                        <t t-if="extra['target_move'] == 'all'">All Entries</t>
                                        <t t-if="extra['target_move'] == 'posted'">All Posted
                                            Entries</t>
                                        <br />
                                        <t t-if="extra['date_to']">
                                            <strong>End Date :</strong>
                                            <span t-esc="extra['date_to']" />
                                        </t>
                                    </div>
                                </div>


                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left;">Date</th>
                                            <th>Journal</th>
                                            <th>Description</th>
                                            <th>Ref</th>
                                            <th style="text-align:right;">Debit</th>
                                            <th style="text-align:right;">Credit</th>
                                            <t t-if="extra['reconciled'] == True">
                                                <th style="text-align:right;">Balance</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="7" style="background:#f0f0f0; font-weight:bold; font-size:12px;">
                                                <strong t-esc="o.name" style='font-size:20px' />
                                            </td>

                                        </tr>


                                        <t t-foreach="extra['currency_ids']" t-as="currency">


                                            <!-- <tr>
                                                <td colspan="7" style='background-color:#F0ECE5;'>
                                                    <strong t-esc="currency.name" />
                                                </td>

                                            </tr> -->

                                            <t t-if="previous_balance(data, o, currency)">
                                                <tr style="font-style:italic; font-size:18px; background:#e6f2ff; font-weight:bold;">

                                                    <t t-if="extra['reconciled'] == True">
                                                        <td colspan='6'>
                                                            Previous Balance
                                                        </td>
                                                    </t>

                                                    <t t-if="extra['reconciled'] != True">
                                                        <td colspan='5'>
                                                            Previous Balance
                                                        </td>
                                                    </t>


                                                    <td nowrap="nowrap" style='font-weight:bold; text-align:right;color:red;'>


                                                        <t t-esc="previous_balance(data, o, currency).get('currency_id')" />
                                                        <t t-esc="'{:,.2f}'.format(previous_balance(data, o, currency).get('previous_balance'))" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-set="accounted_balance" t-value="0.0 + previous_balance(data, o, currency).get('previous_balance')" />

                                            <t t-if="lines(data, o, currency)">


                                                <t t-foreach="lines(data, o, currency)" t-as="line">
                                                    <t t-if="line['debit'] > 0 or line['credit'] > 0">
                                                        <tr>

                                                            <t t-set="accounted_balance" t-value="accounted_balance + line['progress']" />

                                                            <td colspan="1">
                                                                <span t-esc="line['date']" />
                                                            </td>

                                                            <td colspan="1">
                                                                <span t-esc="line['journal_id']" />
                                                            </td>

                                                            <td>
                                                                <t t-esc="line['description']" />
                                                                
                                                                <t t-foreach="get_invoice_data(line['invoice_id'])" t-as="invoice_line">
                                                                    <t t-if="invoice_line.journal_id.type == 'sale'">
                                                                        <br/>
                                                                        <span t-esc="invoice_line.product_id.name"/>
                                                                        <span t-esc="invoice_line.quantity"/>
                                                                        <!--<span t-esc="invoice_line.uom_id.name"/>-->  X
                                                                        <span t-esc="invoice_line.currency_id.symbol"/>
                                                                        <span t-esc="invoice_line.price_unit" t-esc-options="{&quot;widget&quot;: &quot;monetary&quot;}"/> =
                                                                        <span t-esc="invoice_line.currency_id.symbol"/>
                                                                        <span t-esc="invoice_line.price_subtotal" t-esc-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;res_company.currency_id&quot;}"/>
                                                                        <t t-if="invoice_line.tax_ids">
                                                                            + Tax: <span t-esc="', '.join(invoice_line.tax_ids.mapped('name'))"/>
                                                                            
                                                                        </t>
                                                                    </t>
                                                                    
                                                                </t>
                                                            </td>
                                                            <td>
                                                                <span t-esc="line['displayed_name']" />
                                                            </td>


                                                            <td nowrap="nowrap" style="text-align:right;">
                                                                <span t-esc="line['currency_id']" />
                                                                <span t-esc="'{:,.2f}'.format(line['debit']) or 0.00" />
                                                            </td>
                                                            <td nowrap="nowrap" style="text-align:right;">
                                                                <span t-esc="line['currency_id']" />
                                                                <span t-esc="'{:,.2f}'.format(line['credit']) or 0.00" />
                                                            </td>
                                                            <t t-if="extra['reconciled'] == True">
                                                                <td nowrap="nowrap" style="text-align:right;">
                                                                    <span t-esc="line['currency_id']" />
                                                                    <span t-esc="'{:,.2f}'.format(accounted_balance) or 0.00" />


                                                                </td>
                                                            </t>
                                                        </tr>

                                                    </t>


                                                </t>

                                                <tr style="font-weight:bold; background:#ffe6e6;">
                                                    <td colspan='4' style='font-weight:bold;font-size:18px'>
                                                        TOTAL
                                                    </td>
                                                    <td nowrap="nowrap" style="text-align:right;">
                                                        <t t-if="lines(data, o, currency)">
                                                            <strong>
                                                                <span t-esc="lines(data, o, currency)[0].get('currency_id')" />
                                                                <span t-esc="'{:,.2f}'.format(lines(data, o, currency)[0].get('debit_total'))" />
                                                            </strong>
                                                        </t>
                                                    </td>

                                                    <td nowrap="nowrap" style="text-align:right;">
                                                        <t t-if="lines(data, o, currency)">
                                                            <strong>
                                                                <span t-esc="lines(data, o, currency)[0].get('currency_id')" />
                                                                <span t-esc="'{:,.2f}'.format(lines(data, o, currency)[0].get('credit_total'))" />
                                                            </strong>
                                                        </t>
                                                    </td>
                                                    <t t-if="extra['reconciled'] == True">

                                                        <td nowrap="nowrap" style="text-align:right; text-decoration: underline;">
                                                            <t t-if="lines(data, o, currency)">
                                                                <strong>
                                                                    <span t-esc="lines(data, o, currency)[0].get('currency_id')" />
                                                                    <span t-esc="'{:,.2f}'.format(accounted_balance) or 0.00" />
                                                                </strong>
                                                            </t>
                                                        </td>
                                                    </t>
                                                </tr>


                                            </t>
                                        </t>
                                    </tbody>
                                </table>

                            </div>
                        </t>
                    </t>

                    <t t-else="">

                        <div style="font:25px lucida-console,sans-serif !important;font-weight: bold;">
                            <strong>
                                <div>
                                    <center> Customer Statement </center>
                                </div>
                            </strong>
                        </div>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Partner's Account :</strong>
                                <t t-if="extra['account_type'] == 'customer'">Receivable
                                    Accounts</t>
                                <t t-if="extra['account_type'] == 'supplier'">Payable
                                    Accounts</t>
                                <t t-if="extra['account_type'] == 'customer_supplier'">Receivable
                                    and Payable Accounts</t>
                                <br />
                                <t t-if="extra['date_from']">
                                    <strong>Start Date :</strong>
                                    <span t-esc="extra['date_from']" />
                                </t>
                            </div>
                            <div class="col-6">
                                <strong>Target Moves :</strong>
                                <t t-if="extra['target_move'] == 'all'">All Entries</t>
                                <t t-if="extra['target_move'] == 'posted'">All Posted
                                    Entries</t>
                                <br />
                                <t t-if="extra['date_to']">
                                    <strong>End Date :</strong>
                                    <span t-esc="extra['date_to']" />
                                </t>
                            </div>
                        </div>

                        <div class='row'>
                            <h3>Summary</h3>
                        </div>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Partner</th>
                                    <th style="text-align:right;">Previous Balance</th>
                                    <th style="text-align:right;">Debit</th>
                                    <th style="text-align:right;">Credit</th>
                                    <t t-if="extra['reconciled'] == True">
                                        <th style="text-align:right;">Balance</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="extra['currency_ids']" t-as="currency">


                                    <tr>
                                        <td colspan="6">
                                            <strong t-esc="currency.name" style='font-size:20px' />
                                        </td>
                                    </tr>

                                    <t t-foreach="docs" t-as="partner">


                                        <tr t-if="extra['display_zero_values']">
                                            <td></td>
                                            <td>
                                                <strong t-esc="partner.name" />
                                            </td>
                                            <td nowrap="nowrap" style='font-weight:bold; text-align:right;color:red;'>


                                                <t t-esc="previous_balance(data, partner, currency).get('currency_id')" />
                                                <t t-esc="'{:,.2f}'.format(previous_balance(data, partner, currency).get('previous_balance'))" />
                                            </td>


                                            <td nowrap="nowrap" style="text-align:right;">
                                                <t t-if="lines(data, partner, currency)">
                                                    <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                    <strong>
                                                        <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('debit_total'))" />
                                                    </strong>
                                                </t>

                                                <t t-else="">
                                                    <strong t-esc="previous_balance(data, partner, currency).get('currency_id')" />
                                                    <strong>0.0</strong>
                                                </t>
                                            </td>

                                            <td nowrap="nowrap" style="text-align:right;">
                                                <t t-if="lines(data, partner, currency)">
                                                    <strong>
                                                        <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                        <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('credit_total'))" />
                                                    </strong>
                                                </t>

                                                <t t-else="">
                                                    <strong t-esc="previous_balance(data, partner, currency).get('currency_id')" />
                                                    <strong>0.0</strong>
                                                </t>
                                            </td>


                                            <td nowrap="nowrap" style="text-align:right;">
                                                <t t-if="lines(data, partner, currency)">
                                                    <strong>
                                                        <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                        <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('balance_total'))" />
                                                    </strong>
                                                </t>
                                                <t t-else="">
                                                    <strong t-esc="previous_balance(data, partner, currency).get('currency_id')" />
                                                    <strong>0.0</strong>
                                                </t>
                                            </td>


                                        </tr>


                                        <tr t-elif="lines(data, partner, currency)">
                                            <td></td>
                                            <td>
                                                <strong t-esc="partner.name" />
                                            </td>
                                            <td nowrap="nowrap" style='font-weight:bold; text-align:right;color:red;'>


                                                <t t-esc="previous_balance(data, partner, currency).get('currency_id')" />
                                                <t t-esc="'{:,.2f}'.format(previous_balance(data, partner, currency).get('previous_balance'))" />
                                            </td>


                                            <td nowrap="nowrap" style="text-align:right;">
                                                <t t-if="lines(data, partner, currency)">
                                                    <strong>
                                                        <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                        <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('debit_total'))" />
                                                    </strong>
                                                </t>


                                            </td>

                                            <td nowrap="nowrap" style="text-align:right;">
                                                <t t-if="lines(data, partner, currency)">
                                                    <strong>
                                                        <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                        <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('credit_total'))" />
                                                    </strong>
                                                </t>


                                            </td>

                                            <t t-if="extra['reconciled'] == True">
                                                
                                                <td nowrap="nowrap" style="text-align:right;">
                                                    <t t-if="lines(data, partner, currency)">
                                                        <strong>
                                                            <span t-esc="lines(data, partner, currency)[0].get('currency_id')" />
                                                            <span t-esc="'{:,.2f}'.format(lines(data, partner, currency)[0].get('balance_total'))" />
                                                        </strong>
                                                    </t>
                                                    
                                                </td>
                                                
                                            </t>

                                        </tr>


                                    </t>


                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>

            </t>


        </t>
    </template>


</odoo>