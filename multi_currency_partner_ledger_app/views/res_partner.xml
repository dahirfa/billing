<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="multi_currency_partner_ledger_inherit_partner" model="ir.ui.view">
        <field name="name">Multi Currency Partner Ledger</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>    
                    <button name="%(multi_currency_partner_ledger_action)d" class="btn btn-primary" type="action" string="Customer Statement" context="{'default_partner_ids': [id]}"/>
                </header>
            </xpath>

        </field>
    </record>

</odoo>
