<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="unbilled_event_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        th, td {
                            padding: 0.30rem !important;
                            border-top: 1px solid #212529 !important;
                            border-bottom: 1px solid #212529 !important;
                        }
                        th{

                            font-weight: bold !important;

                        }
                    </style>
                    <div class="container" style="font-size:14px;font-family:Arial;margin-top:1px;">
                        <h3>Unbilled Meters Event</h3>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Property</th>
                                    <th>Customer</th>
                                    <th>Zone</th>
                                    <th>Reason</th>
                                    <th>Collector</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="count" t-value="1"/>
                                <t t-foreach="results" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-esc="count"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.property_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.property_id.billing_account_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.zone_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.reason_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.user_id.name"/>
                                        </td>
                                    </tr>

                                    <t t-set="count" t-value="count + 1"/>
                                </t>

                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>



    <record id="action_meter_event_report" model="ir.actions.report">
        <field name="name">Unbilled Meter Event</field>
        <field name="model">mgs.unbilled.meter.event.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_unbilled_meter_event.unbilled_event_report</field>
        <field name="report_file">mgs_unbilled_meter_event.unbilled_event_report</field>
        <field name="print_report_name">'%s - %s' % (object.date_from,object.date_to) </field>
        <field name="binding_type">report</field>
    </record>
</odoo>