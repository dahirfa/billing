<odoo>

  <record id="mgs_billing_form_inehrit_mgs_extend" model="ir.ui.view">
    <field name="name">mgs_billing.property.form.inehrit</field>
    <field name="model">mgs_billing.property</field>
    <field name="inherit_id" ref="mgs_billing.mgs_billing_property_form" />
    <field name="arch" type="xml">

      <xpath expr="//div[@class='oe_button_box']" position="inside">
        <!-- Unbilled Meter Event -->
        <button class="oe_stat_button" name="action_open_meter_event_blocks" string="Unbilled Meter Event" type="object" icon="fa-exclamation-circle" />
      </xpath>

    </field>
  </record>



  <record id="view_mgs_meter_event_blocking_list" model="ir.ui.view">
    <field name="name">Unbilled Meter Event List</field>
    <field name="model">mgs.meter.event.blocking</field>
    <field name="arch" type="xml">
      <list string="Unbilled Meter Event">
        <field name="property_id"/>
        <field name="date"/>
        <field name="reason_id" optional="show"/>
        <field name="user_id" optional="hidden"/>
      </list>
    </field>
  </record>


  <record id="view_mgs_meter_event_blocking_form" model="ir.ui.view">
    <field name="name">Unbilled Meter Event</field>
    <field name="model">mgs.meter.event.blocking</field>
    <field name="arch" type="xml">
      <form string="Meter Event Block">
        <sheet>
          <group>
            <group>
              <field name="property_id"/>
              <field name="reason_id"/>
            </group>
            <group>
              <field name="date"/>
              <field name="user_id"/>              
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <record id="view_mgs_meter_event_blocking_reason_list" model="ir.ui.view">
    <field name="name">Unbilled Meter Event Reason</field>
    <field name="model">mgs.meter.event.blocking.reason</field>
    <field name="arch" type="xml">
      <list editable="top" string="Unbilled Meter Event Reason">
        <field name="name"/>        
      </list>
    </field>
  </record>


  <record id="view_mgs_meter_event_blocking_reason_action" model="ir.actions.act_window">
      <field name="name">Unbilled Meter Event Reason</field>
      <field name="res_model">mgs.meter.event.blocking.reason</field>
      <field name="view_mode">list</field>
  </record>


  <menuitem id="view_mgs_meter_event_blocking_reason_reason" name="Unbilled Meter Event Reason" parent="mgs_billing.mgs_billing_transaction_config" sequence="1" action="view_mgs_meter_event_blocking_reason_action"/>

</odoo>
