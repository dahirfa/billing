<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="inherit_edahab_sc_payment_provider_form" model="ir.ui.view">
        <field name="name">Edahab Short Code Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'edahab_sc'" >
                    <field name="edahab_sc_user_id" required="code == 'edahab_sc_user_id'"/>
                </group>
            </group>
        </field>
    </record>


    
</odoo>