<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="mgs_edahab_sc_inherit_payment_transaction" model="ir.ui.view">
        <field name="name">Edahab Short Code</field>
        <field name="model">mgs.payment.transaction</field>
        <field name="inherit_id" ref="mgs_payment_integration.mgs_payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="method_code" invisible='1'/>
                <button name="action_edahab_sc_confirm" invisible="method_code != 'edahab_sc' or state == 'confirm'" type="object" string="Confirm"/>
                <button name="action_edahab_sc_draft" invisible="method_code != 'edahab_sc' or state == 'draft'" type="object" string="Reset To draft"/>
            </xpath>

        </field>
    </record>

    <record model="ir.actions.act_window" id="action_mgs_payment_transaction_edahab_sc">
        <field name="name">Edahab Short Code Transactions</field>
        <field name="res_model">mgs.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('method_code','=','edahab_sc')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Records</p>
        </field>
    </record>

    <menuitem name="Edahab Short Code" id="mgs_edahab_sc_intergration_menu" action="action_mgs_payment_transaction_edahab_sc" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="3"/>

</odoo>