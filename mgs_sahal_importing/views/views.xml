<odoo>


  <record model="ir.ui.view" id="view_mgs_golis_sahal_payment_tree">
    <field name="name">mgs.golis.sahal.payment.tree</field>
    <field name="model">mgs.golis.sahal.payment</field>
    <field name="arch" type="xml">
      <list decoration-info="state == 'draft'" decoration-success="state == 'confirm'" decoration-warning="state == 'to_confirm'" decoration-danger="state in  ('invalid','duplicate')">
        <field name="transferdate" string="Transfer Date"/>
        <field name="transactionid" string="Transaction #"/>
        <field name="journal_id"/>
        <field name="partner_id"/>
        <field name="otherpartyaccount" string="Sender Name"/>
        <field name="transaction_mobile" string="Sender Mobile"/>
        <field name="meter_no"/>
        <field name="currency_id" invisible="1"/>
        <field name="amount" sum="Total"/>
        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirm'" decoration-warning="state == 'to_confirm'" decoration-danger="state in  ('invalid','duplicate')"/>
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="view_mgs_golis_sahal_payment_form">
    <field name="name">mgs.golis.sahal.payment.form</field>
    <field name="model">mgs.golis.sahal.payment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="currency_id" invisible="1"/>
          <field name="payment_ids" invisible="1"/>
          <field name="payment_id" invisible="1" readonly="1"/>
          <field name="payment_count" invisible="1"/>
          <field name="move_id" invisible="1" readonly="1"/>

          <button name="action_confirm" type="object" invisible="state == 'confirm'" string="Confirm"/>
          <button name="action_draft" type="object" invisible="state == 'draft'" string="Reset to draft"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payments" invisible="payment_count == 0" type="object" width="150" class="oe_stat_button" icon="fa-credit-card">
              <field name="payment_count" widget="statinfo" string="Payment"/>
            </button>

          </div>

          <h1>
            <field name="transactionid" readonly="1"/>
          </h1>

          <h1>
            <field name="partner_id" placeholder="Partner" options="{'no_create': True,  'no_create_edit': True}" invisible="breakdown" readonly="partner_id and state == 'confirm'"/>
          </h1>

          <h1>
            <field name="journal_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" readonly="state == 'confirm'"/>
          </h1>
          <group>
            <group>
              <field name="description" string="Description" readonly="1"/>
              <field name="otherpartyaccount" string="Sender Name" readonly="1"/>
              <field name="debit" invisible="1"/>
              <field name="currency_id" invisible="1"/>
              <field name="amount" readonly="1"/>

            </group>

            <group>
              <field name="transferdate" string="Transfer Date" readonly="1"/>
              <field name="transaction_mobile" readonly="1"/>
              <field name="meter_no" readonly="1"/>
              <field name="breakdown" widget="boolean_toggle" readonly="state == 'confirm'"/>

            </group>
          </group>

          <notebook>
            <!-- <page name="line_ids" string="Breakdown"> -->
            <page name="line_ids" string="Breakdown" invisible="not breakdown">

              <field name="line_ids" readonly="state == 'confirm'">
                <list editable="bottom">
                  <field name="partner_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                  <field name="amount" sum="Total"/>
                  <field name="payment_id" readonly="1"/>
                  <field name="currency_id" invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>

        </sheet>
       <chatter/>
      </form>
    </field>
  </record>

  <record id="mgs_golis_sahal_payment_search" model="ir.ui.view">
    <field name="name">mgs.golis.sahal.payment.search</field>
    <field name="model">mgs.golis.sahal.payment</field>
    <field name="arch" type="xml">
      <search string="Payments">
        <field name="transactionid"/>
        <field name="partner_id"/>
        <field name="transaction_mobile"/>
        <field name="line_ids" string="Payment Lines"/>
        <field name="journal_id"/>
        <field name="transferdate"/>
        <field name="description"/>
        <field name="otherpartyaccount"/>
        <field name="amount"/>
        <filter name="transferdate" string="Payment Date" date="transferdate"/>
        <filter name="to_confirm" string="To Confirm" domain="[('state','=','draft')]"/>
        <group expand="0" string="Group By..." colspan="12" col="10">
          <filter string="Date" name="date" context="{'group_by': 'transferdate'}"/>
          <filter string="Partner" name="partner_id" context="{'group_by': 'partner_id'}"/>
          <filter string="State" name="state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>



  <record model="ir.actions.act_window" id="action_mgs_golis_sahal_payment">
    <field name="name">Import Sahal Payments</field>
    <field name="res_model">mgs.golis.sahal.payment</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No Records</p>
    </field>
  </record>

  <menuitem id="menu_mgs_golis_sahal_payment" name="Sahal-Import" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="3" action="action_mgs_golis_sahal_payment"/>

</odoo>