<odoo>
  <record model="ir.ui.view" id="mgs_billing_billing_customer_form">
      <field name="name">mgs_billing.billing_customer.form</field>
      <field name="model">mgs_billing.billing_customer</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <field name="image" widget="image" class="oe_avatar"/>
            <div class="oe_title">
              <h1><field name="name" placeholder='Full Name' string="Name"/></h1>
            </div>
            <group>
              <group>

                <span class="o_form_label o_td_label" name="address_name">
                  <b>Address</b>
              </span>
                <div class="o_address_format">
                  <field name="street" placeholder="Street..." class="o_address_street"/>
                  <field name="street2" placeholder="Street 2..." class="o_address_street" />
                  <field name="city" placeholder="City" class="o_address_city" />
                  <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"  context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                  <field name="zip" placeholder="ZIP" class="o_address_zip" />
                  <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                </div>
                <!-- <field name="address"/> -->
                <field name="partner_type" widget="radio"/>

              </group>

              <group>
                <field name="id" invisible="1"/>
                <field name="mobile" placeholder="252...."/>
                <field name="phone"  placeholder="252...."/>
                <field name="email"  placeholder="Email"/>
                <field name="document_type_id" options="{'no_create': True}"/>
                <field name="document_no"  placeholder="Eg. ID291.."/>
                <field name="guarantor_id" options="{'no_quick_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
                <field name="remarks"/>
              </group>
            </group>
            
            <notebook>
                <page string="House/Meter Info" name="properties">
                    <field name="property_ids" context="{
                      'default_billing_customer_id': id,
                      'default_street': street,
                      'default_street2': street2,
                      'default_city': city,
                      'default_zip': zip,
                      'default_country_id': country_id,
                      'default_state_id': state_id,
                      }">
                      <list delete='0'>
                        <field name="name"/>
                        <!-- <field name="property_type_id"/> -->
                        <field name="street"/>
                        <field name="company_id"/>
                        <!-- <field name="state"/> -->
                      </list>
                    </field>
                </page>
            </notebook>

          </sheet>

          
          
          <chatter/>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="mgs_billing_billing_customer_tree">
      <field name="name">mgs_billing.billing_customer.tree</field>
      <field name="model">mgs_billing.billing_customer</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" string="Name"/>
          <field name="mobile"/>
          <field name="phone"/>
          <field name="email"/>
          <field name="company_id" groups="base.group_multi_company"  optional='hide'/>
          <field name="partner_type"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="mgs_billing_billing_customer_search">
      <field name="name">mgs_billing.billing_customer.search</field>
      <field name="model">mgs_billing.billing_customer</field>
      <field name="arch" type="xml">
        <search>
          <field name="name" string="Name"/>
          <field name="mobile"/>
          <field name="phone"/>
          <field name="email"/>

          <group expand="0" string="Group By..." colspan="12" col="10">
            <filter string="Guarantor" name="guarantor_id" context="{'group_by': 'guarantor_id'}"></filter>
            <filter string="Type" name="partner_type" context="{'group_by': 'partner_type'}"></filter>
          </group>
        </search>
      </field>
    </record>



    <record model="ir.actions.act_window" id="mgs_billing_customer_action">
      <field name="name">Billing Customer</field>
      <field name="res_model">mgs_billing.billing_customer</field>
      <field name="view_mode">list,form</field>
    </record>
</odoo>