<odoo>
  <record model="ir.ui.view" id="mgs_billing_reading_form">
    <field name="name">mgs_billing.reading.form</field>
    <field name="model">mgs_billing.reading</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!--TODO: Result from converting "states='draft'" attribute into an 'invisible' attribute
                 Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
          <button string="Confirm" name="action_confirm" confirm="Are you Sure?" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
          <!-- <button string="Validate" name="action_validate" confirm="Are you Sure?" type="object" class="oe_highlight" states="pending"/> -->

          <button string="Cancel" name="action_cancel" type="object"/>
          <!--TODO: Result from converting "states='cancel'" attribute into an 'invisible' attribute
                 Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
          <button string="Reset To Draft" name="action_draft" invisible="state not in ['cancel']" type="object"/>


          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button invisible="not move_id" class="oe_stat_button" name="action_open_invoice" type="object" icon="fa-money">
              <field string="Invoice" name="counter" widget="statinfo"/>
            </button>
          </div>
          <div class="oe_title">
            <h1 class="d-flex flex-row">
              <field name="name" readonly="1" placeholder="Number" style="font-size: min(4vw, 2.6rem);" class="ms-3"/>
            </h1>
            <h2>
              <field name="date" placeholder="Date" readonly="state != 'draft'"/>
            </h2>
            <field name="warning_message" widget="badge" decoration-warning="1==1"/>
            <field name="unusual_usage" invisible="1"/>
          </div>
          <group>
            <group>
              <field name="property_id" readonly="state != 'draft'" options="{'no_create': True}"/>
              <field name="last_reading"/>

              <separator string="Usage" colspan="4"/>
              <field name="difference" string="Usage"/>
              <field name="average_usage"/>
              <field name="amount_total" widget="monetary"/>
              <field name="allow_extra_reading"/>
            </group>

            <group>
              <field name="billing_account_id" readonly="1" context="{'form_view_ref': 'mgs_billing.mgs_billing_account_form'}" options="{'no_create': True}"/>
              <field name="current_reading" readonly="state != 'draft'"/>

              <separator string="Pricing" colspan="4"/>
              <field name="pricelist_id" readonly="state != 'draft'" force_save="1" groups="product.group_product_pricelist"/>
              <field name="rate" readonly="True or (state != 'draft')"/>
              <field name="discount" readonly="state != 'draft'" invisible="1"/>

              <field name="company_id" invisible="1" readonly="state != 'draft'"/>
              <field name="currency_id" invisible="1" readonly="state != 'draft'"/>
              <field name="move_id" invisible="1" readonly="state != 'draft'"/>

            </group>
          </group>

          <group>
            <group>
              <field name="company_id" groups="base.group_multi_company" readonly="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
              <field name="comment" readonly="1"/>
            </group>
          </group>


        </sheet>

        <chatter/>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_reading_tree">
    <field name="name">mgs_billing.reading.tree</field>
    <field name="model">mgs_billing.reading</field>
    <field name="arch" type="xml">
      <list decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='posted'">
        <field name="name" string="Number#"/>
        <field name="date"/>
        <field name="property_id" optional="hide"/>
        <field name="billing_account_id"/>
        <field name="last_reading"/>
        <field name="current_reading"/>
        <field name="difference" sum="Total Diff"/>
        <field name="unusual_usage" string="Unusual Usage"/>
        <field name="currency_id" optional="hide"/>
        <field name="rate" sum="Total Rates"/>
        <field name="move_id" optional="hide"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="amount_total" sum="Total"/>
        <field name="invoice_amount" sum="Total"/>
        <field name="state" widget="badge" decoration-warning="state=='pending'" decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='posted' "/>
        <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" optional="show"/>
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_reading_search">
    <field name="name">mgs_billing.reading.search</field>
    <field name="model">mgs_billing.reading</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Number"/>
        <field name="property_id"/>
        <field name="billing_account_id"/>


        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
        <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
        <separator/>
            
        <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid')]"/>
        <filter name="not_paid" string="Not Paid" domain="[('payment_state', '=', 'not_paid')]"/>
        <filter name="partial" string="Partially Paid" domain="[('payment_state', '=', 'partial')]"/>
        <separator/>

        <filter name="unusual_usage" string="Unusual Usage" domain="[('unusual_usage', '=', True)]"/>


        <group expand="0" string="Group By" colspan="12" col="10">
          <filter string="Date" name="date" context="{'group_by': 'date'}"/>
          <filter string="Invoice Date" name="inv_date" context="{'group_by': 'inv_date'}"/>
          <filter string="Property" name="property_id" context="{'group_by': 'property_id'}"/>
          <filter string="Reading State" name="reading_state" context="{'group_by': 'state'}"/>
          <filter string="Payment Status" name="payment_state" context="{'group_by': 'payment_state'}"/>
          <filter string="Billing Account" name="billing_account_id" context="{'group_by': 'billing_account_id'}"/>
          <filter string="Zone" name="zone_id" context="{'group_by': 'zone_id'}"/>
          <filter string="Collector" name="collector_id" context="{'group_by': 'collector_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_reading_action">
    <field name="name">Meter Readings</field>
    <field name="res_model">mgs_billing.reading</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>