<odoo>

  <record id="mgs_billing_collector_tree" model="ir.ui.view">
    <field name="name">MGS Billing Collector List</field>
    <field name="model">res.partner</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <list string="Collector List" default_order="id desc">
        <field name="name"/>
        <field name="mobile" string="Collecotr's Mobile"/>
        <field name="phone" string="Collecotr's Phone"/>
        <field name="assigned_zone_ids" />
      </list>
    </field>
  </record>




  <record model="ir.actions.act_window" id="mgs_billing_collector_action">
    <field name="name">Collectors</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_collector','=', True)]</field>
    <field name="context">{'default_is_collector': True}</field>
    <field name="view_id" ref="mgs_billing_collector_tree"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create a collector</p>
    </field>
  </record>

</odoo>