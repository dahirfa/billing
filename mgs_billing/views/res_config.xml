<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.tailor</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="40"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <!-- <div class="app_settings_block" data-string="Billing" string="Billing" data-key="mgs_billing"> -->
        <app data-string="mgs_billing" string="Billing" name="mgs_billing">

          <block title="Billing Validation">
           

            <setting>
              <div class="o_setting_left_pane">
                <field name="mgs_auto_reconnect_house"/>
              </div>
    
              <div>
                <label for="mgs_reconnection_percentage" string="Reconnection Precentage"/>
                <div class="text-muted">
                  Reconnection Balance Precentage Paid
                </div>
                <field name="mgs_reconnection_percentage" invisible="mgs_auto_reconnect_house!=True"/>
              </div>
            </setting>

            <setting string="Default Price if Reading is less Then X">
              <div class="text-muted">
              If it's less than ____ Make Rate ____
              </div>
              <field name="mgs_billing_if_its_less_than"/>
              <field name="mgs_billing_make_rate"/>
            </setting>


            <setting string="Select Billing Period">
              <div class="text-muted">
                      Billing Period From ___ To ____
              </div>
              <field name="billing_period_start"/>
              <field name="billing_period_end"/>
            </setting>



            <setting string="Restrict Unusual Reading">
              <div class="text-muted" invisible="max_above_avg == 0.0">
                    All Readings above <field name="max_above_avg" widget="percentage" readonly="1"/>
              <br/>
                than Average
            </div>

            <div class="text-muted" invisible="max_under_avg == 0.0">
                    All Readings under <field name="max_under_avg" widget="percentage" readonly="1"/>
            <br/>
          than Average
          </div>

          <div class="text-muted" invisible="max_above_avg == 0.0 and max_under_avg == 0.0">
                    Will go through confirmation
          </div>
          <br/>
          <label for="max_above_avg"/>
          <field name="max_above_avg" widget="percentage"/>

          <label for="max_under_avg"/>
          <field name="max_under_avg" widget="percentage"/>
        </setting>



        <setting string="Property Registeration Date">
          <div class="o_setting_left_pane">
            <field name="is_allow_reg_date" />
          </div>

          <div>
            <label for="allowed_reg_date" string="Property Registeration Date"/>
            <div class="text-muted">
                      Allowed Registeration Date
            </div>
            <field name="allowed_reg_date" invisible="is_allow_reg_date!=True"/>
          </div>
        </setting>

      </block>


      <block title="Default Billing Values">
        <setting string="Billing Invoice Extra Services">
          <field name="mgs_extra_service_ids" options="{'no_create': True}" widget="many2many_tags"/>
        </setting>


        <setting string="Billing Plan Product Category">
          <field name="mgs_plan_categ_id" options="{'no_create': True}"/>
        </setting>


        <setting string="Enable Global Sequence">
          <div class="o_setting_left_pane">
                <field name="mgs_billing_global_seq"/>
              </div>
    
              <div>
                <label for="mgs_billing_global_seq_id" string="Global Sequence"/>
                <div class="text-muted" invisible="mgs_billing_global_seq!=True">
                  Select Global Sequence
                </div>
                <field name="mgs_billing_global_seq_id" invisible="mgs_billing_global_seq!=True"/>
              </div>
        </setting>
      </block>



    </app>
  </xpath>
</field>
</record>

<record id="mgs_billing_config_action" model="ir.actions.act_window">
<field name="name">Settings</field>
<field name="type">ir.actions.act_window</field>
<field name="res_model">res.config.settings</field>
<field name="view_mode">form</field>
<field name="target">inline</field>
<field name="context">{'module' : 'mgs_billing'}</field>
</record>


<record id="mgs_billing_config_action_menu" model="ir.actions.act_window">
<field name="name">Settings</field>
<field name="res_model">res.config.settings</field>
<field name="view_mode">form</field>
<field name="target">inline</field>
<field name="context">{'module' : 'mgs_billing', 'bin_size': False}</field>
</record>

</odoo>