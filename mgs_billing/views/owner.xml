<odoo>
  <record model="ir.ui.view" id="mgs_billing_owner_form">
    <field name="name">mgs_billing.owner.form</field>
    <field name="model">mgs_billing.owner</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" string="Name"/>
            </h1>
          </div>
          <group>
            <group>
              <span class="o_form_label o_td_label" name="address_name">
                <b>Address</b>
              </span>
              <div class="o_address_format">
                <field name="street" placeholder="Street..." class="o_address_street"/>
                <field name="street2" placeholder="Street 2..." class="o_address_street" />
                <field name="city" placeholder="City" class="o_address_city" />
                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                <field name="zip" placeholder="ZIP" class="o_address_zip" />
                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
              </div>
              <field name="owner_type" widget="radio"/>
            </group>

            <group>
              <field name="mobile"/>
              <field name="phone"/>
              <field name="email"/>
              <field name="document_type_id" options="{'no_create': True}"/>
              <field name="document_no"/>
              <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
              <field name="remarks"/>
            </group>
          </group>

        </sheet>

        <chatter/>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_owner_tree">
    <field name="name">mgs_billing.owner.tree</field>
    <field name="model">mgs_billing.owner</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" string="Name"/>
        <field name="mobile"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="company_id" groups="base.group_multi_company" optional='hide'/>
        <field name="owner_type"/>
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_owner_search">
    <field name="name">mgs_billing.owner.search</field>
    <field name="model">mgs_billing.owner</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Name"/>
        <field name="mobile"/>
        <field name="phone"/>
        <field name="email"/>

        <group expand="0" string="Group By..." colspan="12" col="10">
          <!-- <filter string="Guarantor" name="guarantor_id" context="{'group_by': 'guarantor_id'}"></filter> -->
          <filter string="Type" name="owner_type" context="{'group_by': 'owner_type'}"></filter>
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_owner_action">
    <field name="name">Property Owners</field>
    <field name="res_model">mgs_billing.owner</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>