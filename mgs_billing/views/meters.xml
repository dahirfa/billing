<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mgs_billing_meter_tree" model="ir.ui.view">
        <field name="name">mgs_billing.meter.tree</field>
        <field name="model">mgs_billing.meter</field>
        <field name="arch" type="xml">
            <list editable="top" delete="0">
                <field name="meterid" required="meter_type == 'smart'"/>
                <field name="name" required='1'/>
                <field name="property_id" optional="hide"/>
                <field name="meter_type" optional="hide"/>
                <field name="owner" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional='hide'/>
            </list>
        </field>
    </record>

    <record id="mgs_billing.meter_view_search" model="ir.ui.view">
        <field name="name">mgs_billing.meter.view.search</field>
        <field name="model">mgs_billing.meter</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name"/>
                <field name="meterid"/>
                

                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>

            </search>
        </field>
    </record>

    <record id="mgs_billing_meter_action" model="ir.actions.act_window">
        <field name="name">Meters</field>
        <field name="res_model">mgs_billing.meter</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
