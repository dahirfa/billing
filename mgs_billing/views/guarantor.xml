<odoo>
  <record model="ir.ui.view" id="mgs_billing_guarantor_form">
    <field name="name">mgs_billing.guarantor.form</field>
    <field name="model">mgs_billing.guarantor</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" string="Name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="mobile"/>
            </group>

          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_guarantor_tree">
    <field name="name">mgs_billing.guarantor.tree</field>
    <field name="model">mgs_billing.guarantor</field>
    <field name="arch" type="xml">
      <list editable="top">
        <field name="name" string="Name"/>
        <field name="mobile"/>
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_guarantor_search">
    <field name="name">mgs_billing.guarantor.search</field>
    <field name="model">mgs_billing.guarantor</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Name"/>
        <field name="mobile"/>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_guarantor_action">
    <field name="name">Guarantors</field>
    <field name="res_model">mgs_billing.guarantor</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>