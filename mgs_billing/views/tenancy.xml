<odoo>



  <record id="mgs_billing_account_tree" model="ir.ui.view">
    <field name="name">mgs_billing.billing.account.tree</field>
    <field name="model">res.partner</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <list string="Billing Accounts Tee" default_order="property_id asc">
        <field name="property_id" string="House#"/>
        <field name="name"/>
        <!-- <field name="customer_id"/> -->
        <field name="mobile"/>
        <field name="phone"/>
        <field name="product_id" readonly="1"/>
        <field name="activity_ids" optional="show" widget="list_activity"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="mgs_credit" sum="credit"/>
      </list>
    </field>
  </record>


  <record id="partner_billing_form" model="ir.ui.view">
    <field name="name">res.partner.billing</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <!-- Statusbar -->
      <!-- <xpath expr="//form" position="inside">
          <header>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirm" attrs="{'invisible': [('is_tenancy', '=', False)]}"/>
          </header>
        </xpath> -->

      <xpath expr="//field[@id='company']" position="attributes">
        <attribute name="force_save">1</attribute>

        <attribute name="readonly">is_tenancy</attribute>
        <attribute name="required">type == 'contact'</attribute>
        <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
               Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
               (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
        <attribute name="invisible">not is_company</attribute>
        <!--TODO: Result from converting 'attrs' attribute override without options for ['column_invisible'] to separate attributes
               Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
               If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
        <attribute name="column_invisible"/>
      </xpath>

      <xpath expr="//field[@id='individual']" position="attributes">
        <attribute name="force_save">1</attribute>
        <attribute name="readonly">is_tenancy</attribute>
        <attribute name="required">type == 'contact'</attribute>
        <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
               Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
               (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
        <attribute name="invisible">is_company</attribute>
        <!--TODO: Result from converting 'attrs' attribute override without options for ['column_invisible'] to separate attributes
               Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
               If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
        <attribute name="column_invisible"/>
      </xpath>

      <xpath expr="//span[@name='address_name']" position="before">
        <field name="customer_id" readonly="1" options="{'no_create': True}" invisible="not is_tenancy" required="is_tenancy"/>
        <field name="product_id" readonly="1" options="{'no_create': True}" invisible="not is_tenancy" required="is_tenancy"/>
        <field name="property_id" readonly="1" options="{'no_create': True}" invisible="not is_tenancy" required="is_tenancy"/>
        <field name="mgs_credit"/>

      </xpath>

      <!-- Address Inherit -->
      <xpath expr="//span[@name='address_name']" position="attributes">
        <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                 Check if this span tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                 (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
        <attribute name="invisible">is_tenancy</attribute>
      </xpath>

      <xpath expr="//div[@class='o_address_format']" position="attributes">
        <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                 Check if this div tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                 (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
        <attribute name="invisible">is_tenancy</attribute>
      </xpath>

      <xpath expr="//field[@name='vat']" position="before">
        <!-- <field name="owner_id" force_save='1'/> -->
        <!-- <field name="ref" attrs="{'invisible': [('is_tenancy','=', False)], 'required': [('is_tenancy','=', True)]}"/> -->
        <field name="average_usage" invisible="not is_tenancy" required="is_tenancy"/>
        <field name="billing_name" invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='category_id']" position="after">
        <field name="is_tenancy" invisible="1"/>
      </xpath>

    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_tenancy_acc_action">
    <field name="name">Billing Accounts</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids" eval="[(5, 0, 0),(0, 0, {'view_mode': 'list', 'view_id': ref('mgs_billing_account_tree')})]"/>
    <field name="domain">[('is_tenancy','=', True)]</field>
    <field name="context">{'default_is_tenancy': 1,'default_name': "/"}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create Billing Accounts</p>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_collector_action">
    <field name="name">Collectors</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <!-- <field name="view_ids" eval="[(5, 0, 0),(0, 0, {'view_mode': 'list', 'view_id': ref('mgs_billing_account_tree')}),(0, 0, {'view_mode': 'form', 'view_id': ref('mgs_billing_account_form')})]"/> -->
    <field name="domain">[('is_collector','=', True)]</field>
    <field name="context">{'default_is_collector': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create a collector</p>
    </field>
  </record>

</odoo>