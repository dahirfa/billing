<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="mgs_billing_meter_reading_tree" model="ir.ui.view">
        <field name="name">mgs_billing.meter.reading.tree</field>
        <field name="model">mgs_billing.meter.reading</field>
        <field name="arch" type="xml">
            <list string="Reading history">
                <field name="reading_id"/>
                <field name="date"/>
                <field name="property_id"/>
                <field name="product_id"/>
                <field name="reading_on_date"/>
                <field name="previous_reading"/>
                <field name="reading_difference"/>
                <field name="rate"/>
                <field name="invoice_amount"/>
                <field name="state" widget='badge' decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='posted' " />
            </list>
        </field>
    </record>

    <record id="mgs_billing_meter_reading_action" model="ir.actions.act_window">
        <field name="name">Readings History</field>
        <field name="res_model">mgs_billing.meter.reading</field>
        <field name="view_mode">list</field>
    </record>
</odoo>