<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View mgs_billing.payment.collection.wizard form -->
    <record id="view_mgs_billing_payment_collection_wizard_form" model="ir.ui.view">
        <field name="name">view.mgs_billing.payment.collection.wizard.form</field>
        <field name="model">mgs_billing.payment.collection.wizard</field>
        <field name="arch" type="xml">
            <form string="Mgs_billing Payment Collection Wizard">
                <group>
                <group>
                   <field name="date_from" 
                       required="1"
                   />
                    <field name="report_type"/>
                    <field name="zone_id" options="{'no_create': True}"/>
                </group>
                <group>
                    <field name="date_to" 
                    required="1"
                    />
                </group>
            </group>

            <group>

                <field name="collector_id"  options="{'no_create': True}"/>
            </group>

                <footer>
                    <button name="get_payment_collection" type="object" string="View" class="btn btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action mgs_billing.payment.collection.wizard -->
    <record id="action_mgs_billing_payment_collection" model="ir.actions.act_window">
        <field name="name">Payment Collection</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mgs_billing.payment.collection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
