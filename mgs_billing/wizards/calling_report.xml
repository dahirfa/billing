<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="calling_report_form" model="ir.ui.view">
			<field name="name">Calling Report</field>
			<field name="model">mgs_billing.calling_report_wiz</field>
			<field name="arch" type="xml">
			   <form>
					<sheet>
						<group>
							<group>
								<field name="date_from" string = "From"/>
								<field name="zone_id" required="1" string="Zone" options="{'no_create': True}" />
								<field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
								<field name="states" widget="radio" invisible="1"/>
							</group>


							<group>
								<field name="date_to" string="To"/>
								<field name="collector_id" options="{'no_create': True}" />
								<label for="greater_less"/>
								<div>
										<field name="greater_less" class="oe_inline" style="font-weight: bold"/>
										<field name="greater_less_amount" class="oe_inline" style="text-align: right"/>
								</div>   
							</group>
						</group>
					</sheet>

				<footer>
					<button name="confirm" string="View" type="object" class="oe_highlight"/>
					<!-- <button name="export_to_excel" string="EXCEL" type="object" class="oe_highlight"/> -->
					<button string="Cancel" special="cancel"/>
				</footer>

			   </form>
			</field>
		</record>



		<record id="action_calling_report_report" model="ir.actions.act_window">
			<field name="name">Calling Report</field>
			<field name="res_model">mgs_billing.calling_report_wiz</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_id" ref="calling_report_form"/>
			<field name="target">new</field>
		</record>

    <!-- <menuitem id="menu_necsom_addons_report" name="Reporting" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="12" /> -->
</odoo>
