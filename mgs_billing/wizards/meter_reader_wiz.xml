<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_meter_reader_summary_wizard" model="ir.ui.view">
        <field name="name">mgs_billing.meter.reader.summary.wizard.form</field>
        <field name="model">mgs_billing.meter.reader.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Meter Reader Summary">
                <group>
                    <field name="collector_id"/>
                <field name="date" />
               
                </group>
                <footer>
                    <button string="View" type="object" name="action_print_report" class="btn-primary"/> or
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_meter_reader_summary_wizard" model="ir.actions.act_window">
        <field name="name">Meter Reader Summary</field>
        <field name="res_model">mgs_billing.meter.reader.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
        
</odoo>