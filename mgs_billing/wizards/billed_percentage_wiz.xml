<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="mgs_billing_percentage_wizard_form" model="ir.ui.view">
        <field name="name">mgs_billing.percentage.wizard.form</field>
        <field name="model">mgs_billing.percentage.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <label for="month" string="Month"
                                    style="font-weight: bold !important;margin-right:107px;margin-left: 0px;"/>
                            <div class="o_address_format">
                                <field name="year" style="width:40px;margin-left: 1px;height: 20px; border-radius: 4px;"/> /
                                <field name="month" style="width: 45px;"/>
                            </div>
                            <field name="zone_id" string="Zone" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                        </group>
                        <group>
                            <field name="collector_id" string="Collector" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
                            <!-- <field name="company_id" string="Company"  /> -->
                            <!-- <field name="report_by" widget="radio" invisible=/> -->
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_view_report" type="object" string="VIEW"/>
                    <button name="export_excel" type="object" string="EXCEL"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mgs_billing_billed_percentage_wizard_action" model="ir.actions.act_window">
        <field name="name">Household Billed</field>
        <field name="res_model">mgs_billing.percentage.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- <field name="context">{'default_report_by': 'Billed'}</field> -->
    </record>


</odoo>