<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record model="ir.ui.view" id="mgs_billing_payment_report_tree">
    <field name="name">mgs_billing.payment.report.tree</field>
    <field name="model">mgs_billing.payment.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" string="Number#"/>
        <field name="date"/>
        <field name="property_id"/>
        <field name="billing_account_id" />
        <field name="zone_id" optional="show"/>
        <field name="ref" optional="show"/>
        <field name="collector_id" optional="hide"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="amount_total" sum="amount_total"/>
        <!-- <field name="balance" sum="balance"/> -->
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_payment_report_pivot">
    <field name="name">mgs_billing.payment.report.pivot</field>
    <field name="model">mgs_billing.payment.report</field>
    <field name="arch" type="xml">
      <pivot string="Payment Analysis" sample="1">
        <!-- <field name="zone_id" type="col"/> -->
        <field name="date" type="row"/>
        <field name="zone_id" type="row"/>
        <field name="property_id" type="row"/>
        <field name="collector_id" type="row"/>
        <field name="billing_account_id" type="row"/>
        <field name="amount_total" string="Total" type="measure"/>
      </pivot>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_payment_report_search">
    <field name="name">mgs_billing.payment.report.search</field>
    <field name="model">mgs_billing.payment.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Payment#"/>
        <field name="property_id"/>
        <field name="billing_account_id"/>
        <field name="zone_id"/>
        <field name="collector_id"/>

        <group expand="0" string="Group By..." colspan="12" col="10">
          <filter string="Date" name="date" context="{'group_by': 'date'}"></filter>
          <filter string="Property" name="property_id" context="{'group_by': 'property_id'}"></filter>
          <filter string="Billing Account" name="billing_account_id" context="{'group_by': 'billing_account_id'}"></filter>
          <filter string="Zone" name="billing_zone_id" context="{'group_by': 'zone_id'}"></filter>
          <filter string="Collector" name="billing_collector_id" context="{'group_by': 'collector_id'}"></filter>
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_payment_report_action">
    <field name="name">All Receipts</field>
    <field name="res_model">mgs_billing.payment.report</field>
    <field name="view_mode">list,pivot</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>