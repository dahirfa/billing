<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mgs_custom_paperformat2" model="report.paperformat">
        <field name="name">MGS Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>


    <record id="action_calling_report" model="ir.actions.report">
        <field name="name">Calling Report</field>
        <field name="model">mgs_billing.calling_report_wiz</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_billing.calling_report_report</field>
        <field name="report_file">mgs_billing.calling_report_report</field>
        <field name="print_report_name">'Calling Report'</field>
        <field name="paperformat_id" ref="mgs_custom_paperformat2" />
        <field name="binding_type">report</field>
    </record>

    <template id="calling_report_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout" t-lang="en_US">
                    <div class="page">
                        <style>
                            th, td {
                            padding: 0.30rem !important;
                            border-top: 1px solid #212529 !important;
                            border-bottom: 1px solid #212529 !important;
                        }
                        </style>

                        <div class="container" style="font-size:14px;font-family:Arial;margin-top:1px;">
                            <h2>Calling Report</h2>

                            <div class="row" style="margin-top: 32px !important;font-size: 1.2em; font-family: 'Lato-Reg'">

                                <div class="col-3" t-if="date_from or date_to">
                                    <strong>Date:</strong>
                                    <p t-esc="date_from" style="margin-bottom: 0"/>
                                    <p t-esc="date_to"/>
                                </div>

                                <div class="col-3" t-if="zone_id[0]">
                                    <strong>Zone:</strong>
                                    <p class="m-0" t-esc="zone_id[1]"/>
                                </div>

                                <div class="col-3" t-if="collector_id[0]">
                                    <strong>Collector:</strong>
                                    <p class="m-0" t-esc="collector_id[1]"/>
                                </div>


                                <div class="col-4" t-if="company_id" groups="base.group_multi_company">
                                    <strong>Company:</strong>
                                    <span style="border: 1px solid black; padding: 1px; border-radius: 4px; background: #eeebeb; margin-right: 2px " t-esc="company_id.name"/>
                                </div>
                            </div>

                            <table class="table table-condensed table-sm">
                                <thead style="font-weight:bold; font-size:14px">
                                    <tr style="font-weight:bold;">
                                        <th style="font-weight:bold;" nowrap="nowrap">No</th>
                                        <th style="font-weight:bold;" nowrap="nowrap">Property ID</th>
                                        <th style="font-weight:bold;" nowrap="nowrap">Billing Account</th>
                                        <th style="font-weight:bold;" nowrap="nowrap">Sender</th>
                                        <th style="font-weight:bold;" nowrap="nowrap">Tenenat Phone</th>
                                        <th style="font-weight:bold; text-align: right" nowrap="nowrap">Prev Bal</th>
                                        <th style="font-weight:bold; text-align: right" nowrap="nowrap">Curr Bill</th>
                                        <th style="font-weight:bold; text-align: right" nowrap="nowrap">Curr Balance</th>
                                    </tr>
                                </thead>

                                <tbody >
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="total_balance" t-value="0"/>
                                    <tr t-foreach="lines(date_from, date_to, zone_id[0], collector_id[0], company_id.id, greater_less, greater_less_amount)" t-as="line">
                                        <t t-set="no" t-value="no+1"/>
                                        <td nowrap="nowrap">
                                            <span t-esc="no"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['property_name']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['partner_name']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['sender_phone']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['tenant_mobile']"/>
                                        </td>
                                        <td style="text-align: right">
                                            <span t-esc="'{0:,.2f}'.format(line['initial_balance'])"/>
                                        </td>
                                        <td style="text-align: right">
                                            <span t-esc="'{0:,.2f}'.format(line['invoiced'])"/>
                                        </td>
                                        <td style="text-align: right">
                                            <span t-esc="'{0:,.2f}'.format(line['balance'])"/>
                                        </td>

                                        <t t-set="total_balance" t-value="total_balance+line['balance']"/>

                                    </tr>

                                    <tr style="font-weight:bold; font-size:14px; background:#ffe6e6;">
                                        <td colspan="7"></td>
                                        <td style="text-align: right">
                                            <span style="font-weight: bold;" t-esc="'{0:,.2f}'.format(total_balance)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
