<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record model="ir.ui.view" id="mgs_billing_sale_report_tree">
    <field name="name">mgs_billing.sale.report.tree</field>
    <field name="model">mgs_billing.sale.report</field>
    <field name="arch" type="xml">
      <list decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='posted'">
        <field name="name" string="Number#"/>
        <field name="date"/>
        <field name="property_id"/>
        <field name="billing_account_id" />
        <field name="current_reading"/>
        <field name="last_reading"/>
        <field name="difference" sum="difference"/>
        <field name="rate"/>
        <field name="move_id"/>
        <field name="company_id" groups="base.group_multi_company" optional='hide'/>

        <field name="amount_total" sum="amount_total"/>
        <field name="state" widget='badge' decoration-info="state=='draft'" decoration-danger=" state=='cancel' " decoration-success="state=='posted' "/>
        <field name="payment_state" widget='badge' decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" optional="show"/>
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_sale_report_pivot">
    <field name="name">mgs_billing.sale.report.pivot</field>
    <field name="model">mgs_billing.sale.report</field>
    <field name="arch" type="xml">
      <pivot string="Meter Analysis" sample="1">
        <!-- <field name="zone_id" type="col"/> -->
        <field name="date" type="row"/>
        <field name="payment_state" type="row"/>
        <field name="zone_id" type="row"/>
        <field name="product_id" type="row"/>
        <field name="rate" string="Rate" type="measure"/>
        <field name="difference" string="Usage" type="measure"/>
        <field name="amount_total" string="T.Amount" type="measure"/>
      </pivot>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_billing_sale_report_search">
    <field name="name">mgs_billing.sale.report.search</field>
    <field name="model">mgs_billing.sale.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Number"/>
        <field name="property_id"/>
        <field name="billing_account_id"/>

        <group expand="0" string="Group By..." colspan="12" col="10">
          <filter string="Date" name="date" context="{'group_by': 'date'}"></filter>
          <filter string="Property" name="property_id" context="{'group_by': 'property_id'}"></filter>
          <filter string="Billing Account" name="billing_account_id" context="{'group_by': 'billing_account_id'}"></filter>
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="mgs_billing_sale_report_action">
    <field name="name">Reading Analysis</field>
    <field name="res_model">mgs_billing.sale.report</field>
    <field name="view_mode">list,pivot</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>