<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_bill_receivables_report_view" model="ir.actions.report">
        <field name="name">Bill Receivables Report</field>
        <field name="model">mgs_billing.receivables.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_billing.bill_receivables_report_template</field>
        <field name="report_file">mgs_billing.bill_receivables_report_template</field>
        <!-- <field name="binding_model_id" ref="model_load_line_dispatch"/> -->
        <field name="binding_type">report</field>
    </record>

    <template id="portal_my_home_menu_receivables_report" name="Portal layout : receivables menu" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'receivables'" t-attf-class="breadcrumb-item #{'active ' if not receivables else ''}">
                <a t-if="receivables" t-attf-href="/report/receivables?{{ keep_query() }}">My Receivables Report</a>
                <t t-else="">My Receivables Report</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_receivables" name="My Receivalbes" customize_show="True" inherit_id="portal.portal_my_home" priority="1">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My Receivables</t>
                    <t t-set="url" t-value="'/report/receivables'"/>
                    <t t-set="placeholder_count" t-value="'receivables_count'"/>
                    <!-- dd -->
                </t>
            </xpath>
    </template>

    <template id="bill_receivables_report_template" name="Collection Report">
    <t t-call="portal.portal_layout">
        <t t-set="breadcrumbs_searchbar" t-value="True"/>

        <t t-call="portal.portal_searchbar">
            <t t-set="title">My Receivalbes</t>
        </t>
        <t t-if="not data">
            <p>No Result.</p>
        </t>
        <div class="mgs_table">
            <t t-if="data" t-call="portal.portal_table">

                <thead>
                    <tr class="active">
                        <th>No.</th>
                        <th>Meter #</th>
                        <th>Billing Account</th>
                        <th  class="partner_mobile">Mobile</th>
                        <th>Zone</th>
                        <th style="text-align: right;">Initial Balance</th>
                        <th style="text-align: right;">Invoiced</th>
                        <th style="text-align: right;">Paid</th>
                        <th style="text-align: right;">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="no" t-value="0"/>

                    <t t-set="page_balance" t-value="0"/>

                    <tr t-foreach="data" t-as="line">
                        <t t-set="no" t-value="no+1"/>
                        <td><span t-esc="no"/></td>
                        <td><span t-esc="line['property_name']"/></td>
                        <td><span t-esc="line['display_name']"/></td>
                        <td class="partner_mobile"><span t-esc="line['partner_mobile']"/></td>
                        <td><span t-esc="line['zone_name']"/></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(line['initial_balance'])"/></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(line['invoiced'])"/></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(line['paid'])"/></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(line['balance'])"/></td>

                        <!-- Total variables -->
                        <t t-set="page_balance" t-value="page_balance+line['balance']"/>
                    </tr>

                    <tr>
                        <td class="page_subtotal" colspan="8"><span style="text-align: right;">Page Total: </span></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(page_balance)"/></td>
                    </tr>
                    <tr style="font-weight: bold;color: red">
                        <td class="page_total" colspan="8"><span style="text-align: right;">Overall Total: </span></td>
                        <td style="text-align: right;"><span t-esc="'{0:,.2f}'.format(total_balance)"/></td>
                    </tr>
                </tbody>
            </t>
        </div>
    </t>
</template>

