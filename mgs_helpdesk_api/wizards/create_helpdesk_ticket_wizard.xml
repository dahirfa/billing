<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mgs_create_ticket_wizard" model="ir.ui.view">
        <field name="name">Create Ticket Wizard</field>
        <field name="model">mgs.create.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder='Title' required="1" string="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1" placeholder="Partner"/>                        
                            <field name="tag_id" readonly="1" placeholder="Tag"/>                        
                        </group>
                        <group>
                            <field name="team_id" readonly="1" placeholder="Team"/>
                        </group>
                    </group>                    
                </sheet>

                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mgs_create_ticket_action" model="ir.actions.act_window">
        <field name="name">Create Ticket</field>
        <field name="res_model">mgs.create.ticket.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
