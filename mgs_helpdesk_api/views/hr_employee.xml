<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mgs_extend_hr_employee_form_view" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.mgs_extend</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//group[@name='active_group']//field[@name='user_id']" position="attributes">
                <attribute name="domain">[('company_ids', 'in', [company_id])]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
