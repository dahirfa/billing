<odoo>
    <record id="inherit_helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.helpdesk_ticket_view_form.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name='domain'>[]</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_send_sms" string="Send SMS" type="object" class="btn-primary" data-hotkey="q" />
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="zone_id" options="{'no_create': True}"/>
                <field name="street"/>
            </xpath>

            <field name="tag_ids" position="after">
                <field name="qr_code" widget="qr" readonly="1" />
                <field name="qr_image" invisible="qr_code == False or qr_code == ''" widget='image' class="oe_avatar"/>
            </field>

            <xpath expr="//notebook/page[@name='description']" position="after">
                <page name="work_images" string="Work Images">
                    <group>
                        <group name="before_work_starts_image" string="Before Work Image">
                            <field name="before_work_start_image"></field>
                        </group>
                        <group name="after_work_ends_image" string="After Work Image">
                            <field name="after_work_end_image"></field>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="help_desk_settings_view" model="ir.ui.view">
        <field name="name">HelpDesk Conf</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="helpdesk" string="Helpdesk" name="helpdesk">
                    <h2>HelpDesk Settings</h2>

                    <div class="row mt16 o_settings_container" name="sms_config_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="sms_config">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">HELPDESK</span>
                                <span class="fa fa-lg fa-building-o" groups="base.group_no_one" role="img"/>
                                <div class="text-muted">
                                            Set Stages
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="done_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="done_stage_id"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="in_progress_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="in_progress_stage_id"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="to_review_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="to_review_stage_id"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="cancel_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="cancel_stage_id"/>
                                    </div>

                                    <div class="row mt16">
                                        <label for="suspended_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="suspended_stage_id"/>
                                    </div>

                                    <div class="row mt16">
                                        <label for="draft_stage_id" options="{'no_create_edit': True}" class="col-lg-3 o_light_label"/>
                                        <field name="draft_stage_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>


    <record id="mgs_helpdesk_api_config_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'helpdesk'}</field>
    </record>


    <menuitem id="mgs_billing_settings_menu" name="Settings" parent="helpdesk.helpdesk_menu_config" action="mgs_helpdesk_api_config_action" sequence="-99"/>







</odoo>