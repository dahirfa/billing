<odoo>
    <record id="view_transfer_wizard_form" model="ir.ui.view">
        <field name="name">mgs_cash_transfer.wizard.form</field>
        <field name="model">mgs_cash_transfer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="date_to" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="print_report" string="View" type="object" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Report</field>
        <field name="res_model">mgs_cash_transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_transfer_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_transfer_report" name="Report" parent="menu_cash_transfer_root" action="action_transfer_wizard"/>
</odoo>
