<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_transfer" model="ir.actions.report">
        <field name="name">Transfer Report</field>
        <field name="model">mgs_cash_transfer.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_cash_transfer.report_transfer</field>
        <field name="report_file">mgs_cash_transfer.report_transfer</field>
        <field name="binding_model_id" ref="model_mgs_cash_transfer_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_transfer">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        th, td {
                            padding: 0.30rem !important;
                            border-top: 1.5px solid #212529 !important;
                            border-bottom: 1.5px solid #212529 !important;
                        }
                        th {
                            font-weight: bold;
                        }
                        .text-right {
                            text-align: right;
                        }
                    </style>

                    <div class="container" style="font-size:14px;font-family:Arial;margin-top:1px;">
                        <h2>Transfer Report</h2>

                        <table class="table table-condensed table-sm" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total" t-value="0"/>
                                <t t-foreach="docs" t-as="o">
                                    <tr>
                                        <td><t t-esc="o.date"/></td>
                                        <td><t t-esc="o.journal_id.name"/></td>
                                        <td><t t-esc="o.destination_journal_id.name"/></td>
                                        <td><t t-esc="o.memo"/></td>
                                        <td class="text-right">
                                            <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <t t-set="total" t-value="total + o.amount"/>
                                    </tr>
                                </t>
                                <tr t-if="not docs">
                                    <td colspan="5" class="text-center">No transfers found</td>
                                </tr>
                            </tbody>
                            <tfoot t-if="docs">
                                <tr>
                                    <td colspan="4" class="text-right"><strong>Total:</strong></td>
                                    <td class="text-right">
                                        <strong>
                                            <span t-esc="total" t-options="{'widget': 'monetary', 'display_currency': docs[0].currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
