<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="account_payment_inherit_template_form" model="ir.ui.view">
        <field name="name">account.payment.spark</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="spark_eligible" invisible="1"/>
                <field name="spark_pid" invisible="1"/>
                <button name="action_create_spark_payment" string="Register Spark-Payment" invisible="spark_eligible != True or spark_pid != False" type="object" data-hotkey="q"/>
            </xpath>
        </field>
    </record>





    <record id="inherit_account_payment_prepayment_action" model="ir.actions.act_window">
        <field name="name">Prepayments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('prepaid_electricity', '=', True), ('property_payment_type', '=', 'pre_paid')]</field>
        <field name="context">{'default_partner_type': 'supplier', 'payment_type':'inbound'}</field>
        <field name="help" type="html">
            <p>Create new prepayment</p>
        </field>
    </record>


    <menuitem id="mgs_menu_prepayment" parent="mgs_payment_integration.mgs_payment_integration_root" action="inherit_account_payment_prepayment_action" sequence="1" name="Prepayment"/>








</odoo>
