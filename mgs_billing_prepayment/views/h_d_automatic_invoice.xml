<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.sequence" id="seq_auto_tax_readings">
        <field name="name">Spark Meter Readings</field>
        <field name="code">mgs.tax.auto.invoice.seq</field>
        <field name="prefix">ATAX/%(year)s/%(month)s/</field>
        <field name="padding">3</field>
        <field name="company_id"></field>
      </record>

      <record id="mgs_auto_invoice_tax_cron" model="ir.cron">
        <field name="name">Prepayment : Create H/D Tax Invoices</field>
        <field name="model_id" ref="model_mgs_tax_auto_invoice"/>
        <field name="state">code</field>
        <field name="code">model.action_auto_invoice_hd_taxes()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>months</field>
        <!-- <field name="numbercall">-1</field>
        <field name="doall" eval="False"/> -->
    </record>
    
      
    <record id="view_mgs_tax_auto_invoice_form" model="ir.ui.view">
        <field name="name">mgs.sparkmeter.reading.form</field>
        <field name="model">mgs.tax.auto.invoice</field>
        <field name="arch" type="xml">
          <form>
            <header>
              <button string="Run Manually" name="action_trigger_cron" type="object" class="oe_highlight"/>
              <field name="state" widget="statusbar" statusbar_visible="queue,done"/>

            </header>
            <sheet>
              <div class="oe_button_box" name="button_box">
                  <button class="oe_stat_button text-success" name="action_open_invoices" type="object" icon="fa-home">
                      <field string="Invoices" name="invoice_count" widget="statinfo" class='text-success'/>
                  </button>
              </div>
  
              <h1>
                <field name="name"/>
              </h1>
              
            <h2>
               <field name="date"/>
            </h2>
              
  
              <group>
                <field name="to_bill_count"/>
                <field name="progress" widget="progressbar"/>
                <!-- <field name="cursor"/> -->
              </group>
              
              <notebook>
                <page string="properties" >
                  <field name="property_ids"/>
                </page>
                
              </notebook>

            </sheet>
            <chatter/>
          </form>
        </field>
      </record>
  
      <record id="view_mgs_tax_auto_invoice_tree" model="ir.ui.view">
        <field name="name">mgs.sparkmeter.reading.tree</field>
        <field name="model">mgs.tax.auto.invoice</field>
        <field name="arch" type="xml">
          <list>
              <field name="name"/>
              <field name="date"/>
              <field name="to_bill_count"/>
              <field name="progress" widget="progressbar"/>
          </list>
        </field>
      </record>
  
      <record id="action_mgs_tax_auto_invoice" model="ir.actions.act_window">
        <field name="name">Automatic Invoices</field>
        <field name="res_model">mgs.tax.auto.invoice</field>
        <field name="view_mode">list,form</field>
      </record>


      <menuitem
      id="mgs_tax_auto_invoice_menu"
      name="H/D Tax Invoice"
        action="action_mgs_tax_auto_invoice"
      parent="mgs_sparkmeter.mgs_billing_reading_menu_main"
      sequence="1"
    />
    

</odoo>
