<odoo>

  <record id="mgs_inherit_view_account_journal_form" model="ir.ui.view">
    <field name="name">inherit.view_account_journal_form.form</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='type']" position="before">
        <field name="mgs_bank_no" invisible="type != 'bank'"/>
      </xpath>
    </field>
  </record>


  <record id="mgs_inherit_view_account_payment_form" model="ir.ui.view">
    <field name="name">account.view_account_payment_form.form</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="mgs_partner_bal" style="font-weight: bold;color:red" invisible="payment_type != 'inbound' or not partner_id"/>
      </xpath>
      <xpath expr="//field[@name='memo']" position="before">
        <field name="mgs_transaction_ref" invisible="payment_type != 'inbound'"/>
        <field name="mgs_sender_phone" invisible="payment_type != 'inbound'" readonly="state != 'draft'"/>
      </xpath>
    </field>
  </record>


  <record id="mgs_inherit_view_account_payment_search" model="ir.ui.view">
    <field name="name">account.view_account_payment_.search</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_search"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="mgs_sender_phone"/>
        <field name="mgs_transaction_ref"/>
      </xpath>
    </field>
  </record>

  <record model="ir.ui.view" id="mgs_payment_transaction_form">
    <field name="name">mgs.payment.transaction.form</field>
    <field name="model">mgs.payment.transaction</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,confirm"/>

        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payments" invisible="not payment_ids" type="object" width="150" class="oe_stat_button" icon="fa-credit-card">Payment
            </button>
          </div>
          <div class="oe_title mb24">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
            <h1>
              <field name="partner_id" options="{'no_create': True, 'no_create_edit': True}" placeholder="Partner" invisible="breakdown" readonly="partner_id and state == 'confirm'"/>
            </h1>
          </div>

          <group>
            <group>
              <field name="date" readonly="1"/>
              <field name="ref" readonly="1"/>
              <field name="payment_id" invisible="1" readonly="1"/>
            </group>

            <group readonly="1">
              <field name="journal_id" readonly="1"/>
              <field name="method_id" readonly="1"/>
              <field name="currency_id" invisible="1"/>
              <field name="payment_ids" invisible="1"/>
              <field name="amount" readonly="1"/>
              <field name="breakdown" widget="boolean_toggle" readonly="state == 'confirm'"/>

            </group>
          </group>
          <notebook>
            <page name="line_ids" string="Breakdown" invisible="not breakdown">
              <field name="line_ids" readonly="state == 'confirm'">
                <list editable="bottom">
                  <field name="partner_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                  <field name="amount" sum="Total"/>
                  <field name="payment_id" readonly="1"/>

                </list>
              </field>
            </page>
          </notebook>


        </sheet>
        <chatter/>
      </form>
    </field>
  </record>


  <record model="ir.ui.view" id="view_mgs_payment_transaction_tree">
    <field name="name">mgs.payment.transaction.tree</field>
    <field name="model">mgs.payment.transaction</field>
    <field name="arch" type="xml">
      <list create="0">
        <field name="date"/>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="currency_id" invisible="1"/>
        <field name="amount" sum="Total"/>
        <field name="state" widget="badge" decoration-danger="state in ('cancel','duplicate')" decoration-success="state == 'confirm'" decoration-warning="state == 'pending'" decoration-info="state == 'draft'"/>

      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="view_mgs_payment_transaction_search">
    <field name="name">mgs.payment.transaction.search</field>
    <field name="model">mgs.payment.transaction</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="description"/>
        <field name="state"/>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="action_mgs_e_payment_transaction">
    <field name="name">E-Payment</field>
    <field name="res_model">mgs.payment.transaction</field>
    <field name="view_mode">form</field>
  </record>

  <menuitem name="E-Payments" id="mgs_payment_integration_root" web_icon="mgs_payment_integration,static/description/icon.png" groups="group_collection_user"/>
  <menuitem id="mgs_menu_action_account_payments_receivable" parent="mgs_payment_integration_root" action="account.action_account_payments" sequence="-1" name="Manual Payments"/>
  <!-- <menuitem name="Payment Methods" id="mgs_payment_integration_payment_method_menu" action="mgs_payment_integration_payment_method_action" parent="mgs_payment_integration_root"/> -->


</odoo>