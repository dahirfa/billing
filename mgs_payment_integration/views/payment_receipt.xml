                                <t t-set="rec_amount_payment" t-value="0"/>
                                <t t-set="currencyPayment" t-value="False"/>
                
                                <t t-foreach="inv._get_reconciled_invoices_partials()[0]" t-as="par">
                                    <t t-set="payment_line" t-value="par[2]"/>
                                    <t t-set="amountInvoice" t-value="par[1]"/>
                                    <t t-set="amountPayment" t-value="par[0].amount"/>
                
                                    <t t-if="(payment_line.payment_id and payment_line.payment_id == o)
                                             or (payment_line.move_id and payment_line.move_id == o)
                                             or (payment_line == o)
                                             or (payment_line.id == o.id)">
                                        <t t-set="rec_amount_invoice" t-value="amountInvoice"/>
                                        <t t-set="rec_amount_payment" t-value="amountPayment"/>
                                        <t t-set="currencyPayment" t-value="payment_line.currency_id or (payment_line.move_id.currency_id if (payment_line.move_id) else False)"/>
                                    </t>
                                </t>
                
                                <tr>
                                    <td><span t-out="sn"/></td>
                                    <td><span t-field="inv.journal_id.name"/></td>
                                    <td><span t-field="inv.name"/></td>
                                    <td><span t-field="inv.invoice_date_due"/></td>
                                    
                                    <td t-if="otherCurrency" class="text-end">
                                        <span t-if="currencyPayment and currencyPayment != inv.currency_id"
                                              t-out="rec_amount_payment"
                                              t-options="{'widget': 'monetary', 'display_currency': currencyPayment}"/>
                                    </td>
                
                                    <td class="text-end">
                                        <span t-field="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                    </td>
                
                                    <td class="text-end">
                                        <span t-out="rec_amount_invoice" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-set="sn" t-value="sn + 1"/>
                        </t>
                    </tbody>
                </table>
                

                <p t-if="o.memo" class="mt-2">
                    <strong>Payment Comments :</strong>
                    <span t-esc="o.memo"/>
                </p>

                <div class="row mt-4">
                    <div class="col-4">
                        <p>Sign: ___________________________</p>
                    </div>
                    <div class="col-4 text-end">
                        <strong>
                            Paid Amount: <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/><br/>
                        </strong>
                    </div>
                    <div class="col-4 text-end">
                        <strong>
                           
                            Outstanding Amount: <span t-esc="o.partner_id.mgs_credit"/>
                        </strong>
                    </div>
                </div>

                
            </div>
        </t>
    </template>
</odoo>
