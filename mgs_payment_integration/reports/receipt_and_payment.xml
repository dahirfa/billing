<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_receipt_and_payment" model="ir.actions.report">
        <field name="name">Payment Report</field>
        <field name="model">mgs_payment_integration.receipt_and_payment</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mgs_payment_integration.receipt_and_payment_report</field>
        <field name="report_file">mgs_payment_integration.receipt_and_payment_report</field>
        <field name="print_report_name">'Payment Report'</field>
        <field name="binding_model_id" ref="model_mgs_payment_integration_receipt_and_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="receipt_and_payment_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout" t-lang="en_US">
                <div class="page">
                     <style>
                        th, td {
                            padding: 0.30rem !important;
                            border-top: 1.5px solid #212529 !important;
                            border-bottom: 1.5px solid #212529 !important;
                        }
                        th {
                            font-weight: bold;
                        }
                        </style>

                    <div class="container" style="font-size:14px;font-family:Arial;margin-top:1px;">
                        <h2>Payment and Receipt</h2>

                         <!-- Filters header -->
                            <div class="row" style="margin-top: 32px !important;font-size: 1.1em;">
                                <div class="col-3" t-if="date_from or date_to">
                                    <strong>Date:</strong>
                                    <p t-esc="date_from" class="m-0"/>
                                    <p t-esc="date_to"/>
                                </div>
                                <div class="col-3" t-if="partner_id[0]">
                                    <strong>Partner:</strong>
                                    <p class="m-0" t-esc="partner_id[1]"/>
                                </div>
                                <div class="col-3" t-if="journal_id[0]">
                                    <strong>Journal:</strong>
                                    <p class="m-0" t-esc="journal_id[1]"/>
                                </div>
                                <div class="col-3" t-if="user_id[0]">
                                    <strong>User:</strong>
                                    <p class="m-0" t-esc="user_id[1]"/>
                                </div>
                                <div class="col-3" t-if="payment_type">
                                    <strong>Payment Type:</strong>
                                    <p class="m-0" t-esc="payment_type"/>
                                </div>
                                <div class="col-4" t-if="company_id" groups="base.group_multi_company">
                                    <strong>Company:</strong>
                                    <span style="border: 1px solid black; padding: 1px; border-radius: 4px; background: #eeebeb; margin-right: 2px" t-esc="company_id.name"/>
                                </div>
                            </div>

                        <!-- Call Summary or Detailed -->
                        <t t-if="doc.report_type == 'summary'">
                            <t t-call="mgs_payment_integration.receipt_and_payment_report_summary_table"/>
                        </t>
                        <t t-else="">
                            <t t-call="mgs_payment_integration.receipt_and_payment_report_detailed_table"/>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>


  

</odoo>