<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record model="ir.module.category" id="module_mgs_payment_integrations">

        <field name="description">Collection Access Rights</field>
        <field name="name">Collection</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_collection_user" model="res.groups">
        <field name="category_id" ref="module_mgs_payment_integrations"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4, ref('account.group_account_invoice'))]"/>
        <field name="name">Collection User</field>
    </record>

    <record id="group_collection_manager" model="res.groups">
        <field name="category_id" ref="module_mgs_payment_integrations"/>
        <field name="implied_ids" eval="[(4, ref('group_collection_user'))]"/>
        <field name="name">Collection Manager</field>
    </record>

</odoo>