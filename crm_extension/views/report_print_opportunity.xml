<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<report
		 id="action_print_opportunity"
		 name="crm_extension.print_opportunity_report"
		 model="crm_extension.print_opportunity_report"
		 string="Applicants Report"
		 report_type="qweb-html"
 />
 <!--  paperformat="paperformat_custom" -->


		<template id="print_opportunity_report">
				<t t-call="web.html_container">
					<t t-foreach="docs" t-as="doc">
						 <t t-call="web.internal_layout" t-lang="en_US">
								<div class="page">
								<style>
											.table-sm th,td {
													border: 1px solid #212529;
											}
									</style>
									<div class="container">
											<h2 class="text-left">Applicants Report</h2>

											<div id="informations" class="row mt2 mb2">

												<div class="col-auto mw-100 mb-2"  style="width: 33.3%; float: left;">
													<strong>Date:</strong>
													<span class="m-0" t-esc="date"/>
												</div>

                        <div class="col-auto mw-100 mb-2" style="width: 33.3%; float: left;">
													<strong>Stage:</strong>
													<span class="m-0" t-esc="stage_name"/>
												</div>

												<div class="col-auto mw-100 mb-2"  name="due_date" style="width: 33.3%; float: left;" groups="base.group_multi_company">
													<strong>Company:</strong>
													<span class="m-0" t-esc="company_id.name"/> </div>
											</div>

											<div class="row">
												<table class="table table-bordered table-sm">
													<thead>
														<tr>
															<th style="width: 10%" class="text-center">No</th>
															<th>Customer</th>
															<th class="text-center">Mobile</th>
                              <th>Address</th>
															<!-- <th>Total</th> -->
														</tr>
													</thead>

													<tbody>
														<t t-set="no" t-value="0" />
                            <tr t-foreach="lines(date, stage_id, company_id.id)" t-as="line">
															<t t-set="no" t-value="no+1" />
															<td class="text-center" style="width: 10%"><span t-esc="no" /></td>
                              <td style="width: 35%"><span t-esc="line['name']"/></td>
                              <td class="text-center" style="width: 30%">
																	<span t-esc="line['phone']"/>
																	<!-- <t t-if="line['phone']"> / <span t-esc="line['phone']"/></t> -->
															</td>
                              <td style="width: 25%"><span t-esc="line['street']"/></td>
                            </tr>
													</tbody>
												</table>
											</div> <!--tow-->
										</div>
								</div> <!--page-->
							</t> <!--web.external_layout-->
						</t>
				</t> <!--web.html_container-->
		</template>
</odoo>
