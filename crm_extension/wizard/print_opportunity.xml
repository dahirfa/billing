<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="print_opportunity_form" model="ir.ui.view">
			<field name="name">crm_extension.print_opportunity.form</field>
			<field name="model">crm_extension.print_opportunity</field>
			<field name="arch" type="xml">
				 <form>
					<sheet>
						<group>
							<group>
								<field name="date" string="Date" />
                <field name="company_id" groups="base.group_multi_company" widget="selection" />
							</group>
							<group>
                <field name="stage_id" required="1" string="Stage" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
							</group>
						</group>
					</sheet>

				<footer>
					<button name="confirm" string="View" type="object" class="oe_highlight"/>
					<button string="Cancel" special="cancel"/>
				</footer>

				 </form>
			</field>
		</record>



		<record id="action_print_opportunity_form" model="ir.actions.act_window">
			<field name="name">Applicants Report</field>
			<field name="res_model">crm_extension.print_opportunity</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="print_opportunity_form"/>
			<field name="target">new</field>
		</record>


		<menuitem id="menu_print_opportunity" name="Applicants" parent="crm.crm_menu_report" action="action_print_opportunity_form" sequence="1" />

</odoo>
