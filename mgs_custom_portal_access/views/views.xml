<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- wizard action on res.partner -->
        <record id="mgs_partner_wizard_action_create_and_open" model="ir.actions.server">
            <field name="name">Custom Grant portal access</field>
            <field name="model_id" ref="mgs_custom_portal_access.model_mgs_portal_wizard"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">action = model.mgs_action_open_wizard()</field>
        </record>

        <record id="mgs_partner_wizard_action" model="ir.actions.act_window">
            <field name="name">Custom Grant portal access</field>
            <field name="res_model">mgs.portal.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" eval="False"/>
        </record>

        <!-- wizard view -->
        <record id="mgs_wizard_view" model="ir.ui.view">
            <field name="name">Custom Grant portal access</field>
            <field name="model">mgs.portal.wizard</field>
            <field name="arch" type="xml">
                <form string="Portal Access ">
                    <div class="mb-3">
                        Select which contacts should belong to the portal in the list below.
                        The email address of each selected contact must be valid and unique.
                        If necessary, you can fix any contact's email address directly in the list.
                    </div>
                    
                    <field name="user_ids" class="o_portal_wizard_user_one2many" widget="portal_wizard_user_one2many">
                        <list string="Contacts" editable="bottom" create="false" delete="false">
                            <field name="partner_id" force_save="1"/>
                            <field name="email" invisible="is_internal == True"/>
                            <field name="password" password="True"/>
                            <field name="email_state" invisible="1"/>
                            <button name="action_refresh_modal" type="object" icon="fa-check text-success"
                                invisible="(email_state != 'ok' or is_portal == False) and is_internal == False" />
                            <button name="action_refresh_modal" type="object" icon="fa-user-times text-danger"
                                invisible="email_state != 'exist'" title="Email Address already taken by another user"/>
                            <field name="login_date"/>
                            <field name="is_portal" invisible="1"/>
                            <field name="is_internal" invisible="1"/>
                            <button string="Grant Access" name="mgs_action_grant_access" type="object" class="btn-secondary"
                                invisible="is_portal == True or is_internal == True" />
                            <button string="Change Password" name="change_password" type="object" class="btn-secondary"
                               invisible="is_portal == False or is_internal == True" />
                            <button string="Internal User" invisible="is_internal == False"
                                disabled="True" title="This partner is linked to an internal User and already has access to the Portal."/>
                        </list>
                    </field>
                    <footer>
                        <button string="Close" class="btn-primary" special="save" data-hotkey="v" />
                    </footer>
                </form>
            </field>
        </record>
</odoo>
