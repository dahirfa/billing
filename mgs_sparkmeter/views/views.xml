<odoo>
  <data>

    <record id="mgs_sparkmeter_meter_assign_tree" model="ir.ui.view">
      <field name="name">mgs_sparkmeter.meter.assign.tree</field>
      <field name="model">mgs_sparkmeter.meter.assign</field>
      <field name="arch" type="xml">

        <list editable="top">
          <header>
            <button string="Assign" name="action_assign" type="object" class="oe_highlight"/>
          </header>
          <field name="meter_id"/>
          <field name="property_id" options="{'no_create': True}"/>
          <field name="valid_state" widget='badge' decoration-success="valid_state == 'valid'" decoration-danger="valid_state == 'invalid'"/>
          <field name="state" widget='badge' readonly='1'  decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
        </list>
      </field>
    </record>

    <record id="mgs_sparkmeter_meter_assign_action" model="ir.actions.act_window">
      <field name="name">Meter Assign</field>
      <field name="res_model">mgs_sparkmeter.meter.assign</field>
      <field name="view_mode">list</field>
    </record>



    <!-- Res Config -->
    <record id="view_mgs_billing_sparkmeter_config_form_inherit" model="ir.ui.view">
      <field name="name">res.config.settings.form.sparkmeter</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="mgs_billing.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('app_settings_block')]" position="inside">
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
              </div>
              <div class="o_setting_right_pane">
                  <span class="o_form_label">Spark Meter</span>
                  <div class="text-muted">
                      Connect MGS Billing module to Spark Meter
                  </div>
                  <div class="content-group">
                      <div class="row mt16">
                          <label for="mgs_sparkmeter_api_link" string="API Link" class="col-lg-3 o_light_label"/>
                          <field name="mgs_sparkmeter_api_link" placeholder="API Link"/>
                      </div>

                      <div class="row mt16">
                        <label for="mgs_sparkmeter_api_key" string="API Key" class="col-lg-3 o_light_label"/>
                        <field name="mgs_sparkmeter_api_key" placeholder="API Key"/>
                      </div>

                      <div class="row mt16">
                        <label for="mgs_sparkmeter_api_secret" string="API Secret" class="col-lg-3 o_light_label"/>
                        <field name="mgs_sparkmeter_api_secret" placeholder="API Secret"/>
                      </div>

                      <div class="row mt16">
                        <label for="mgs_meters_per_click" string="Meters Per Click" class="col-lg-3 o_light_label"/>
                        <field name="mgs_meters_per_click" placeholder="Meters Per Click"/>                          
                      </div>

                      <div class="row mt16">
                        <label for="mgs_sparkmeter_follower_ids" string="Spark Mail Followers" class="col-lg-3 o_light_label"/>
                        <field name="mgs_sparkmeter_follower_ids" placeholder="Spark Mail Followers" 
                        widget="many2many_tags"
                        />                          
                      </div>

                       <div class="row mt16">
                        <label for="mgs_sparkmeter_service_area_id" string="Sevice Area ID" class="col-lg-3 o_light_label"/>
                        <field name="mgs_sparkmeter_service_area_id" placeholder="Sevice Area ID"/>                          
                      </div>


                      <div class="row mt16">
                        <label for="mgs_sparkmeter_prb" string="Prevent Readings Before" class="col-lg-3 o_light_label"/>
                        <field name="mgs_sparkmeter_prb" placeholder="Prevent Readings Before"/> days
                      </div>


                      </div>
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>

    <!-- Plan -->
    <record id="product_inherit_template_form" model="ir.ui.view">
      <field name="name">product_prodcut.form.sparkmeter</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="mgs_billing.product_inherit_template_form" />
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">  
          <field name="property_sparkmeter_tariff_id" invisible="1"/>                 
          <button string="Create Tariff" name="action_create_sparkmeter_tariff" invisible="is_billing_pan == False and property_sparkmeter_tariff_id == False" type="object" />
          <button string="Update Tariff" name="action_update_sparkmeter_tariff" invisible="is_billing_pan == False and property_sparkmeter_tariff_id == True" type="object" />
        </xpath>
      </field>
    </record>

    <!-- Customer Wizard -->
    <record id="mgs_sparkmeter_create_customer_wizard_form" model="ir.ui.view">
        <field name="name">mgs_sparkmeter.create_customer.wizard.form</field>
        <field name="model">mgs_sparkmeter.create.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                  <field name="meter_id" placeholder="Serial #"/>
                    <p style='color:green;' invisible="meterid == 'Invalid' or meter_id == False">Valid Serial Number</p>
                    <p style='color:red;' invisible="meterid != 'Invalid' or meter_id == False">This Serial number is Invalid or Used</p>
                    
                    <field name="property_id" invisible='1' readonly="1" string="Property#" options="{'no_create': True}" />
                    <field name="meterid" invisible='1'/>
                </sheet>

                <footer>
                  <button name="action_confirm" invisible="meterid == 'Invalid' or meter_id == False" string="Confirm" type="object" class="oe_highlight"/>
                  <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mgs_sparkmeter_create_customer_action" model="ir.actions.act_window">
        <field name="name">Assign Sparkmeter</field>
        <field name="res_model">mgs_sparkmeter.create.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Property -->
    
  </data>
</odoo>