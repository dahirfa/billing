<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mgs_sparkmeter_reading_log_tree" model="ir.ui.view">
    <field name="name">mgs_sparkmeter.reading.log.tree</field>
    <field name="model">mgs_sparkmeter.reading.log</field>
    <field name="arch" type="xml">

      <list decoration-info="1==1">
        <header>
          <button string="Confirm" name="action_create_reading" type="object" class="oe_highlight"/>
        </header>

        <field name="create_date" optional='hide'/>
        <field name="property_id" optional='hide'/>
        <field name="code"/>
        <field name="zone_id"/>
        <field name="serial"/>
        <field name="customer_name" optional='hide'/>
        <field name="latest_reading"/>
        <field name="meter_state"/>
        <field name="eligible" optional='hide'/>
        <field name="state" invisible="eligible == False" widget='badge' decoration-info=" state=='queue'" decoration-success=" state=='posted'" decoration-danger=" state=='fail'"/>
        <field name="reading_id" optional='hide'/>
        <field name="comment" optional='hide'/>
        <field name="checked" optional='hide' widget="boolean_button"/>
      </list>
    </field>
  </record>

  <record id="view_mgs_sparkmeter_reading_log_search" model="ir.ui.view">
    <field name="name">mgs.sparkmeter.reading.log.search</field>
    <field name="model">mgs_sparkmeter.reading.log</field>
    <field name="arch" type="xml">
      <search string="Sparkmeter Reading Log">
        <!-- Filters -->
        <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
        <filter string="In Queue" name="filter_queue" domain="[('state', '=', 'queue')]"/>
        <filter string="Failed" name="filter_fail" domain="[('state', '=', 'fail')]"/>
        <separator/>
        <filter string="Eligible" name="filter_eligible" domain="[('eligible', '=', True)]"/>
        <separator/>
        <filter string="No Last Reading" name="filter_has_last_reading" domain="[('has_last_reading', '=', False),('property_id', '!=', False)]"/>

        <!-- Group By -->
        <group expand="0" string="Group By">
          <filter string="State" name="state" context="{'group_by': 'state'}"/>
          <filter string="Eligible" name="eligible" context="{'group_by': 'eligible'}"/>
          <filter string="Comment" name="comment" context="{'group_by': 'comment'}"/>
          <filter string="Zone" name="zone_id" context="{'group_by': 'zone_id'}"/>
          <!-- Add more group by options as needed -->
        </group>

        <!-- Fields to display -->
        <field name="serial"/>
        <field name="comment"/>
        <field name="state"/>
        <field name="property_id"/>
        <field name="customer_name"/>
        <field name="code"/>
        <field name="meter_state"/>
      </search>
    </field>
  </record>






  <record id="mgs_billing_reading_spark_inherit_form" model="ir.ui.view">
    <field name="name">mgs_billing.reading.form.inherit</field>
    <field name="model">mgs_billing.reading</field>
    <field name="inherit_id" ref="mgs_billing.mgs_billing_reading_form" />
    <field name="arch" type="xml">

      <button name="action_confirm" position="after">
        <field name="meter_type" invisible="1"/>
        <field name="spark_current_reading" invisible="1"/>
        <button name="action_sparkmeter_reading" type="object" string="SPARK READING" invisible="meter_type != 'smart' or state != 'draft'"/>
      </button>


      <field name="warning_message" position="after">
        <p class="italic-text" style="color: red;" invisible="spark_current_reading == 0 or meter_type != 'smart'">Spark-Reading: <field name="spark_current_reading" readonly="1" />
        </p>
      </field>
    </field>
  </record>
  <!-- Reading -->

  <record id="view_mgs_sparkmeter_reading_form" model="ir.ui.view">
    <field name="name">mgs.sparkmeter.reading.form</field>
    <field name="model">mgs_sparkmeter.reading</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button string="Run Manually" name="action_trigger_cron" type="object" class="oe_highlight"/>
          <button string="Confirm Manually" name="action_trigger_validation_cron" type="object" class="oe_highlight"/>
          <field name="state" widget="statusbar" statusbar_visible="queue,done"/>

        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button text-success" name="action_open_readings" type="object" icon="fa-home">
              <field string="Readings" name="reading_count" widget="statinfo" class='text-success'/>
            </button>

            <button class="oe_stat_button text-danger" name="action_fail_open_log" type="object" icon="fa-exclamation-triangle">
              <field string="Failed" name="fail_log_count" widget="statinfo" class='text-danger'/>
            </button>

            <button class="oe_stat_button text-info" name="action_open_log" type="object" icon="fa-clock-o">
              <field string="In Queue" name="log_count" widget="statinfo" class='text-info'/>
            </button>

          </div>

          <h1>
            <field name="name"/>
          </h1>
          <h2>
            <field name="date"/>
          </h2>
          <group>
            <group>
              <field name="start_date" readonly='1'/>
              <field name="state"/>
            </group>

            <group>
              <field name="end_date" readonly='1'/>
            </group>
          </group>

          <group>
            <field name="to_bill_count"/>
            <field name="progress" widget="progressbar"/>
            <!-- <field name="cursor"/> -->
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_mgs_sparkmeter_reading_tree" model="ir.ui.view">
    <field name="name">mgs.sparkmeter.reading.tree</field>
    <field name="model">mgs_sparkmeter.reading</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="progress" widget="progressbar"/>
      </list>
    </field>
  </record>

  <record id="action_mgs_sparkmeter_reading" model="ir.actions.act_window">
    <field name="name">SparkMeter Readings</field>
    <field name="res_model">mgs_sparkmeter.reading</field>
    <field name="view_mode">list,form</field>
  </record>



  <record id="mgs_sparkmeter_reading_log_action" model="ir.actions.act_window">
    <field name="name">Sparkmeter Log</field>
    <field name="res_model">mgs_sparkmeter.reading.log</field>
    <field name="view_mode">list</field>
  </record>



</odoo>
