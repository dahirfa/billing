<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meter_downloader_form" model="ir.ui.view">
        <field name="name">mgs_billing.meter_downloader.form</field>
        <field name="model">mgs_billing.meter.getter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Download" name="action_trigger_cron" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button invisible="meter_count == 0" class="oe_stat_button" name="action_open_meters" type="object" icon="fa-home">
                            <field string="Meters" name="meter_count" widget="statinfo" />
                        </button>
                    </div>

                        <h1>
                            <field name="name" placeholder="Batch #3"/>
                        </h1>

                        <field name="cursor" readonly="1"/>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>
    
    <record id="view_meter_downloader_tree" model="ir.ui.view">
        <field name="name">mgs_billing.meter_downloader.tree</field>
        <field name="model">mgs_billing.meter.getter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="meter_count"/>
            </list>
        </field>
    </record>

    <record id="action_open_meter_downloader" model="ir.actions.act_window">
        <field name="name">Download Spark Meter</field>
        <field name="res_model">mgs_billing.meter.getter</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>
