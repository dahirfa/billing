<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="mgs_waafipay_inherit_payment_transaction" model="ir.ui.view">
        <field name="name">Waafipay</field>
        <field name="model">mgs.payment.transaction</field>
        <field name="inherit_id" ref="mgs_payment_integration.mgs_payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="method_code" invisible='1'/>
                <button name="action_waafipay_confirm" invisible="method_code != 'waafipay' or state == 'confirm'" type="object" string="Confirm"/>
                <button name="action_waafipay_draft" invisible="method_code != 'waafipay' or state == 'draft'" />
            </xpath>

        </field>
    </record>

    <record model="ir.actions.act_window" id="action_mgs_payment_transaction_waafipay">
        <field name="name">Waafipay Transactions</field>
        <field name="res_model">mgs.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('method_code','=','waafipay')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Records</p>
        </field>
    </record>

    <menuitem name="Waafipay" id="mgs_waafipay_intergration_menu" action="action_mgs_payment_transaction_waafipay" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="3"/>

</odoo>