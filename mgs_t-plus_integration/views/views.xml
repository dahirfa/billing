<odoo>
  <data>
    <record id="mgs_t_plus_payment_inherit_payment_provider" model="ir.ui.view">
      <field name="name">T-plus Payment Integration Form</field>
      <field name="model">payment.provider</field>
      <field name="inherit_id" ref="payment.payment_provider_form"/>
      <field name="arch" type="xml">
        <group name="provider_credentials" position="inside">
          <group invisible="code != 't_plus'">
            <field name="t_plus_user_id" password='1' required="code == 't_plus'" />
          </group>
        </group>
      </field>
    </record>

    <record id="mgs_t_plus_inherit_payment_transaction" model="ir.ui.view">
      <field name="name">T-Plus</field>
      <field name="model">mgs.payment.transaction</field>
      <field name="inherit_id" ref="mgs_payment_integration.mgs_payment_transaction_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='state']" position="after">
          <field name="method_code" invisible='1'/>
          <button name="action_t_plus_confirm" invisible="method_code != 't_plus' or state == 'confirm'" type="object" string="Confirm"/>
          <button name="action_t_plus_draft" invisible="method_code != 't_plus' or state == 'draft'" type="object" string="Reset To draft"/>
        </xpath>

      </field>
    </record>

    <record model="ir.actions.act_window" id="action_mgs_payment_transaction_t_plus">
      <field name="name">T-Plus Transactions</field>
      <field name="res_model">mgs.payment.transaction</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('method_code','=','t_plus')]</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No Records</p>
      </field>
    </record>

    <menuitem name="T-Plus" id="mgs_payment_integration_payment_menu_t_plus" action="action_mgs_payment_transaction_t_plus" parent="mgs_payment_integration.mgs_payment_integration_root" sequence="3"/>


  </data>
</odoo>